view,
text,
button,
input,
scroll-view,
canvas,
image {
  box-sizing: border-box;
}

button {
  padding: 0;
  margin: 0;
  background: transparent;
  border: 0;
  border-radius: 0;
  line-height: normal;
  text-align: inherit;
  white-space: nowrap;
  word-break: keep-all;
  writing-mode: horizontal-tb;
}

button::after {
  border: 0;
}

button[disabled],
.primary-btn.disabled,
.secondary-btn.disabled {
  opacity: 0.46;
}

page {
  --background: #f5f1e8;
  --foreground: #2a1f17;
  --card: #ffffff;
  --primary: #c56a4c;
  --primary-foreground: #fffaf0;
  --secondary: #eee5d5;
  --muted-foreground: #9c8e7a;
  --accent: #7fb29a;
  --destructive: #b84b3a;
  --border: #e2d6c3;
  --cream: #f5f1e8;
  --warm-white: #ffffff;
  --cocoa: #2a1f17;
  --charcoal: #33302e;
  --silver-warm: #9c8e7a;
  --clay: #c56a4c;
  --clay-soft: #e08363;
  --mint: #7fb29a;
  --butter: #e8b649;
  --strawberry: #d04f3f;
  --card-border: rgba(42, 31, 23, 0.06);

  --font-xs: 20rpx;
  --font-sm: 24rpx;
  --font-md: 28rpx;
  --font-lg: 32rpx;
  --font-xl: 40rpx;

  --radius-sm: 12rpx;
  --radius-md: 20rpx;
  --radius-lg: 40rpx;
  --radius-pill: 999rpx;

  min-height: 100vh;
  background: var(--background);
  color: var(--foreground);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: var(--font-md);
}

@media (prefers-color-scheme: dark) {
  page {
    --background: #1a1614;
    --foreground: #f0ebe4;
    --card: #2a2420;
    --primary: #e08363;
    --primary-foreground: #1a1210;
    --secondary: #3a322a;
    --muted-foreground: #9c8e7a;
    --accent: #7fb29a;
    --destructive: #e06050;
    --border: #3e362e;
    --cream: #1a1614;
    --warm-white: #2a2420;
    --cocoa: #f0ebe4;
    --charcoal: #e8e0d8;
    --silver-warm: #9c8e7a;
    --clay: #e08363;
    --clay-soft: #f0a080;
    --mint: #7fb29a;
    --butter: #e8b649;
    --strawberry: #e06050;
    --card-border: rgba(255, 255, 255, 0.06);
  }
}

.screen {
  height: 100vh;
  min-height: 0;
  overflow: hidden;
  background: var(--background);
  color: var(--foreground);
  display: flex;
  flex-direction: column;
}

.scroll-body {
  flex: 1;
  height: 0;
  min-height: 0;
  overflow: hidden;
  padding: 24rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

scroll-view.scroll-body {
  display: block;
}

.app-header {
  position: relative;
  height: var(--nav-height, calc(112rpx + env(safe-area-inset-top)));
  padding-top: var(--nav-top, calc(20rpx + env(safe-area-inset-top)));
  flex-shrink: 0;
  display: flex;
  align-items: center;
  background: var(--background);
  z-index: 2;
}

.header-side {
  width: 180rpx;
  display: flex;
  align-items: center;
  padding-left: 8rpx;
}

.header-side.right {
  justify-content: flex-end;
  padding-left: 0;
  padding-right: 8rpx;
  gap: 12rpx;
}

.header-center {
  position: absolute;
  left: 180rpx;
  right: 180rpx;
  top: var(--nav-top, calc(20rpx + env(safe-area-inset-top)));
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}

.header-title {
  max-width: 100%;
  color: var(--foreground);
  font-size: 30rpx;
  font-weight: 650;
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.header-subtitle {
  max-width: 100%;
  margin-top: 2rpx;
  color: var(--muted-foreground);
  font-size: 20rpx;
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.back-btn,
.icon-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--warm-white);
  border: 2rpx solid var(--card-border);
  color: var(--foreground);
  font-size: 36rpx;
  box-shadow: 0 16rpx 34rpx -26rpx rgba(42, 31, 23, 0.2);
}

.icon-btn {
  font-size: 30rpx;
}

.icon-row {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.step-bar {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 20rpx 24rpx;
  background: var(--background);
}

.step-item {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
}

.step-dot {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--secondary);
  color: var(--muted-foreground);
  font-size: 20rpx;
  font-weight: 700;
}

.step-item.active .step-dot {
  background: rgba(197, 106, 76, 0.16);
  color: var(--primary);
  box-shadow: 0 0 0 4rpx rgba(197, 106, 76, 0.16);
}

.step-item.done .step-dot {
  background: var(--primary);
  color: var(--primary-foreground);
}

.step-text {
  color: var(--muted-foreground);
  font-size: 22rpx;
  white-space: nowrap;
}

.step-item.active .step-text {
  color: var(--foreground);
  font-weight: 600;
}

.step-line {
  height: 2rpx;
  flex: 1;
  background: var(--border);
}

.step-item.done .step-line {
  background: var(--primary);
}

.card {
  background: var(--warm-white);
  border: 2rpx solid var(--card-border);
  border-radius: 40rpx;
  box-shadow:
    0 2rpx 4rpx rgba(42, 31, 23, 0.03),
    0 24rpx 54rpx -28rpx rgba(42, 31, 23, 0.13);
}

.card.padded {
  padding: 24rpx;
}

.section-title {
  color: var(--foreground);
  font-size: 26rpx;
  font-weight: 650;
}

.section-muted {
  color: var(--muted-foreground);
  font-size: 22rpx;
}

.bottom-bar {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx calc(34rpx + env(safe-area-inset-bottom));
  background: var(--warm-white);
  border-top: 1rpx solid var(--card-border);
  box-shadow: 0 -18rpx 44rpx -36rpx rgba(42, 31, 23, 0.22);
  z-index: 3;
}

.primary-btn,
.secondary-btn,
.ghost-btn {
  min-width: 0;
  height: 88rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 0 32rpx;
  font-size: 28rpx;
  font-weight: 600;
  white-space: nowrap;
  word-break: keep-all;
  overflow: hidden;
  text-overflow: ellipsis;
}

.primary-btn {
  flex: 1;
  background: var(--primary);
  color: var(--primary-foreground);
  box-shadow: 0 18rpx 34rpx -26rpx rgba(197, 106, 76, 0.7);
}

.secondary-btn {
  background: var(--warm-white);
  color: var(--foreground);
  border: 2rpx solid var(--card-border);
  box-shadow: 0 12rpx 28rpx -28rpx rgba(42, 31, 23, 0.18);
}

.ghost-btn {
  height: 72rpx;
  padding: 0 20rpx;
  color: var(--primary);
  font-size: 26rpx;
}

.segmented {
  display: flex;
  padding: 8rpx;
  border-radius: 999rpx;
  background: rgba(42, 31, 23, 0.05);
  border: 1rpx solid var(--card-border);
}

.segment {
  flex: 1;
  height: 58rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--muted-foreground);
  font-size: 26rpx;
  font-weight: 600;
}

.segment.active {
  background: var(--warm-white);
  color: var(--foreground);
  box-shadow: 0 2rpx 8rpx rgba(42, 31, 23, 0.08);
}

.form-label {
  margin-bottom: 12rpx;
  color: var(--foreground);
  font-size: 26rpx;
  font-weight: 600;
}

.text-input {
  height: 80rpx;
  padding: 0 24rpx;
  border: 2rpx solid var(--card-border);
  border-radius: 20rpx;
  background: #fbf8f2;
  color: var(--foreground);
  font-size: 28rpx;
}

.stat-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.stat-grid.cols-3 {
  grid-template-columns: repeat(3, 1fr);
}

.stat {
  min-width: 0;
}

.stat-label {
  color: var(--muted-foreground);
  font-size: 22rpx;
  line-height: 1.2;
}

.stat-value {
  margin-top: 4rpx;
  color: var(--foreground);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tag {
  display: inline-flex;
  align-items: center;
  border-radius: 999rpx;
  padding: 4rpx 14rpx;
  background: rgba(197, 106, 76, 0.1);
  color: var(--primary);
  font-size: 20rpx;
  font-weight: 600;
  white-space: nowrap;
}

.tag.muted {
  background: var(--secondary);
  color: var(--muted-foreground);
}

.tag.warning {
  background: rgba(127, 178, 154, 0.16);
  color: var(--accent);
}

.palette-scroll {
  white-space: nowrap;
  margin-left: -24rpx;
  margin-right: -24rpx;
  padding: 0 24rpx 4rpx;
}

.palette-chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  min-height: 60rpx;
  padding: 0 24rpx;
  margin-right: 14rpx;
  border: 2rpx solid var(--card-border);
  border-radius: 999rpx;
  background: var(--warm-white);
  color: var(--foreground);
  font-size: 24rpx;
  font-weight: 600;
  white-space: nowrap;
  word-break: keep-all;
}

.palette-chip.active {
  border-color: var(--primary);
  background: var(--primary);
  color: var(--primary-foreground);
}

.palette-chip .mini-tag {
  padding: 2rpx 8rpx;
  border-radius: 999rpx;
  background: rgba(127, 178, 154, 0.16);
  color: var(--accent);
  font-size: 18rpx;
}

.palette-chip.active .mini-tag {
  background: rgba(255, 255, 255, 0.2);
  color: var(--primary-foreground);
}

.bead-list {
  overflow: hidden;
  border: 2rpx solid var(--card-border);
  border-radius: 36rpx;
  background: var(--warm-white);
  box-shadow: 0 18rpx 42rpx -34rpx rgba(42, 31, 23, 0.16);
}

.bead-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  min-height: 100rpx;
  padding: 18rpx 24rpx;
  border-bottom: 1rpx solid var(--card-border);
}

.bead-row:last-child {
  border-bottom: 0;
}

.swatch {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
  border-radius: 12rpx;
  box-shadow: inset 0 0 0 1rpx rgba(42, 31, 23, 0.12);
}

.bead-main {
  min-width: 0;
  flex: 1;
}

.bead-code {
  color: var(--foreground);
  font-size: 26rpx;
  font-weight: 700;
}

.bead-name {
  margin-top: 4rpx;
  color: var(--muted-foreground);
  font-size: 22rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.bead-count {
  min-width: 72rpx;
  text-align: right;
  color: var(--foreground);
  font-size: 28rpx;
  font-weight: 700;
}

.hidden-canvas,
.hidden-export {
  position: fixed;
  left: -9999px;
  top: -9999px;
  width: 10px;
  height: 10px;
}

.empty-state {
  padding: 96rpx 48rpx;
  text-align: center;
  color: var(--muted-foreground);
}

.page {
  min-height: 100vh;
  padding: 28rpx 24rpx;
  background: var(--background);
  color: var(--foreground);
}

.section {
  margin-bottom: 24rpx;
}

.title {
  color: var(--foreground);
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.2;
}

.subtitle,
.muted {
  margin-top: 8rpx;
  color: var(--muted-foreground);
  font-size: 24rpx;
  line-height: 1.4;
}

.small {
  font-size: 22rpx;
}

.panel {
  border: 2rpx solid var(--card-border);
  border-radius: 36rpx;
  background: var(--warm-white);
  padding: 24rpx;
  box-shadow: 0 18rpx 42rpx -34rpx rgba(42, 31, 23, 0.14);
}

.btn,
.chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 60rpx;
  padding: 0 22rpx;
  border: 2rpx solid var(--card-border);
  border-radius: 999rpx;
  background: var(--warm-white);
  color: var(--foreground);
  font-size: 24rpx;
  font-weight: 600;
  white-space: nowrap;
  word-break: keep-all;
}

.chip {
  margin-right: 12rpx;
}

.chip.active,
.btn {
  border-color: var(--primary);
  background: var(--primary);
  color: var(--primary-foreground);
}

.canvas-shell {
  border: 2rpx solid var(--card-border);
  border-radius: 32rpx;
  overflow: hidden;
  background: var(--warm-white);
}

/* v0 React workbench visual sync */
.tone-clay {
  --tone-color: var(--clay);
  --tone-soft: rgba(197, 106, 76, 0.2);
}

.tone-mint {
  --tone-color: var(--mint);
  --tone-soft: rgba(127, 178, 154, 0.22);
}

.tone-butter {
  --tone-color: var(--butter);
  --tone-soft: rgba(232, 182, 73, 0.22);
}

.tone-berry {
  --tone-color: var(--strawberry);
  --tone-soft: rgba(208, 79, 63, 0.18);
}

.tone-sky {
  --tone-color: #8fb6d9;
  --tone-soft: rgba(143, 182, 217, 0.24);
}

.screen,
.page,
.draw-page,
.detail-page {
  background:
    radial-gradient(ellipse 120% 90% at 50% 0%, var(--tone-soft, rgba(197, 106, 76, 0.16)) 0%, transparent 54%),
    var(--background);
}

.screen {
  position: relative;
}

.scroll-body {
  position: relative;
  padding: 24rpx 32rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  background-image:
    radial-gradient(circle at 1rpx 1rpx, rgba(42, 31, 23, 0.045) 1rpx, transparent 2rpx);
  background-size: 28rpx 28rpx;
}

.app-header {
  position: relative;
  height: var(--nav-height, calc(116rpx + env(safe-area-inset-top)));
  padding: var(--nav-top, calc(20rpx + env(safe-area-inset-top))) 32rpx 12rpx;
  display: grid;
  grid-template-columns: 156rpx 1fr 156rpx;
  align-items: center;
  gap: 22rpx;
  background:
    linear-gradient(180deg, rgba(255, 253, 248, 0.86) 0%, rgba(245, 241, 232, 0.74) 100%);
  z-index: 6;
}

.app-header::after {
  content: "";
  position: absolute;
  left: 44rpx;
  right: 44rpx;
  bottom: 0;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, var(--card-border) 18%, var(--card-border) 82%, transparent);
}

.header-side {
  width: auto;
  padding-left: 0;
}

.header-side.right {
  padding-right: 0;
  gap: 12rpx;
}

.header-center {
  position: static;
  min-width: 0;
  pointer-events: auto;
}

.header-title {
  max-width: 100%;
  color: var(--foreground);
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.15;
}

.header-subtitle {
  margin-top: 6rpx;
  color: var(--muted-foreground);
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1.2;
}

.back-btn,
.icon-btn,
.round-btn,
.round-icon {
  width: 72rpx;
  height: 72rpx;
  border: 2rpx solid rgba(42, 31, 23, 0.06);
  border-radius: 50%;
  background: rgba(255, 253, 248, 0.88);
  color: var(--foreground);
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.72),
    0 18rpx 38rpx -30rpx rgba(42, 31, 23, 0.34);
}

.card,
.panel,
.preview-card,
.info-card,
.bead-card,
.sample-card,
.upload-panel,
.project-card,
.empty-card,
.missing-card {
  border: 2rpx solid rgba(42, 31, 23, 0.07);
  background:
    linear-gradient(180deg, rgba(255, 253, 248, 0.98) 0%, rgba(255, 250, 242, 0.98) 100%);
  box-shadow:
    0 2rpx 4rpx rgba(42, 31, 23, 0.03),
    0 30rpx 64rpx -38rpx rgba(42, 31, 23, 0.2);
}

.card,
.panel,
.preview-card,
.sample-card,
.upload-panel,
.project-card,
.empty-card,
.missing-card {
  border-radius: 34rpx;
}

.section-title,
.card-title,
.project-title,
.detail-title,
.upload-title,
.hint-title,
.smart-title,
.match-title {
  color: var(--foreground);
  font-weight: 850;
  letter-spacing: 0;
}

.section-muted,
.card-subtitle,
.muted,
.subtitle,
.upload-sub,
.hint-text,
.smart-sub,
.bead-name,
.project-meta,
.project-time {
  color: var(--muted-foreground);
  font-weight: 650;
  letter-spacing: 0;
}

.primary-btn,
.secondary-btn,
.ghost-btn,
.action-btn,
.mini-btn,
.empty-btn {
  border-radius: 999rpx;
  font-weight: 850;
  letter-spacing: 0;
}

.primary-btn,
.action-btn.primary,
.mini-btn.primary,
.empty-btn {
  background: var(--tone-color, var(--primary));
  color: #fffaf0;
  box-shadow: 0 22rpx 44rpx -30rpx rgba(197, 106, 76, 0.72);
}

.secondary-btn,
.ghost-btn,
.action-btn,
.mini-btn {
  border: 2rpx solid rgba(42, 31, 23, 0.07);
  background: rgba(255, 253, 248, 0.9);
  color: var(--foreground);
}

.bottom-bar {
  position: relative;
  padding: 20rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  background: linear-gradient(to top, rgba(245, 241, 232, 0.98) 66%, rgba(245, 241, 232, 0));
  border-top: 0;
  box-shadow: none;
}

.segmented {
  padding: 8rpx;
  border: 2rpx solid rgba(42, 31, 23, 0.06);
  border-radius: 999rpx;
  background: rgba(42, 31, 23, 0.05);
}

.segment {
  height: 62rpx;
  border-radius: 999rpx;
  font-weight: 850;
}

.segment.active {
  color: var(--tone-color, var(--primary));
  background: #fffdf8;
  box-shadow: 0 8rpx 22rpx -18rpx rgba(42, 31, 23, 0.28);
}

.bead-list,
.bead-list-detail,
.match-list,
.project-list,
.palette-cards {
  overflow: hidden;
  border: 2rpx solid rgba(42, 31, 23, 0.06);
  border-radius: 28rpx;
  background: rgba(255, 253, 248, 0.58);
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.46);
}

.bead-row,
.bead-row-detail,
.project-row,
.palette-card {
  border-bottom: 1rpx solid rgba(42, 31, 23, 0.06);
  background: transparent;
}

.bead-row:last-child,
.bead-row-detail:last-child,
.project-row:last-child,
.palette-card:last-child {
  border-bottom: 0;
}

.swatch,
.sample-swatch,
.brand-swatch,
.recent-dot {
  box-shadow:
    inset 0 0 0 1rpx rgba(42, 31, 23, 0.14),
    inset 0 3rpx 5rpx rgba(255, 255, 255, 0.28);
}

/* v0 layout primitives used by the real miniapp pages */
.flow-body {
  background-image:
    radial-gradient(circle at 1rpx 1rpx, rgba(42, 31, 23, 0.045) 1rpx, transparent 2rpx);
  background-size: 28rpx 28rpx;
}

.card-feature {
  position: relative;
  border: 2rpx solid rgba(42, 31, 23, 0.07);
  border-radius: 34rpx;
  background: linear-gradient(180deg, rgba(255, 253, 248, 0.98) 0%, rgba(255, 250, 242, 0.98) 100%);
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.64),
    0 2rpx 4rpx rgba(42, 31, 23, 0.03),
    0 30rpx 64rpx -38rpx rgba(42, 31, 23, 0.2);
}

.step-indicator {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 12rpx 6rpx 0;
}

.step-meta {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 20rpx;
}

.step-counter {
  color: var(--foreground);
  font-size: 22rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
}

.step-total {
  margin-left: 8rpx;
  color: var(--muted-foreground);
}

.step-current {
  color: var(--tone-color, var(--primary));
  font-size: 22rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
}

.step-track {
  height: 4rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: rgba(42, 31, 23, 0.08);
}

.step-fill {
  display: block;
  height: 100%;
  border-radius: inherit;
  background: var(--foreground);
}

.v0-section-title {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 4rpx 6rpx 0;
}

.v0-section-title::before {
  content: "";
  order: 2;
  flex: 1;
  height: 1rpx;
  background: rgba(42, 31, 23, 0.08);
}

.section-label {
  flex-shrink: 0;
  color: var(--foreground);
  font-size: 22rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
}

.section-action {
  order: 3;
  flex-shrink: 0;
  color: var(--muted-foreground);
  font-size: 20rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
}

.floating-chip {
  position: absolute;
  right: 24rpx;
  top: 24rpx;
  z-index: 5;
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  height: 56rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: rgba(42, 31, 23, 0.78);
  color: #fffdf8;
  font-size: 22rpx;
  font-weight: 900;
  box-shadow: 0 16rpx 32rpx -24rpx rgba(42, 31, 23, 0.4);
}

.bottom-action-bar {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  background: linear-gradient(to top, rgba(245, 241, 232, 0.98) 66%, rgba(245, 241, 232, 0));
  z-index: 8;
}

.primary-action,
.secondary-action {
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 900;
  white-space: nowrap;
}

.primary-action {
  flex: 1;
  color: #fffaf0;
  background: var(--tone-color, var(--primary));
  box-shadow: 0 22rpx 44rpx -30rpx rgba(197, 106, 76, 0.72);
}

.secondary-action {
  padding: 0 28rpx;
  color: var(--foreground);
  background: rgba(255, 253, 248, 0.92);
  box-shadow: inset 0 0 0 2rpx rgba(42, 31, 23, 0.07);
}

.progress-track {
  display: block;
  height: 8rpx;
  margin-top: 14rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: rgba(42, 31, 23, 0.08);
}

.progress-track view {
  display: block;
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, var(--clay), var(--clay-soft));
}

.loading-pixels {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 22rpx;
  padding: 46rpx 32rpx 44rpx;
  border: 2rpx solid rgba(42, 31, 23, 0.07);
  border-radius: 38rpx;
  background: linear-gradient(180deg, rgba(255, 253, 248, 0.98), rgba(255, 250, 242, 0.98));
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.64),
    0 30rpx 66rpx -46rpx rgba(42, 31, 23, 0.22);
  text-align: center;
}

.loading-board {
  position: relative;
  width: 164rpx;
  aspect-ratio: 1 / 1;
  display: grid;
  place-items: center;
  overflow: hidden;
  border-radius: 30rpx;
  background:
    linear-gradient(to right, rgba(217, 205, 179, 0.5) 1rpx, transparent 1rpx),
    linear-gradient(to bottom, rgba(217, 205, 179, 0.5) 1rpx, transparent 1rpx),
    #fbf6ec;
  background-size: 24rpx 24rpx;
  box-shadow:
    inset 0 0 0 2rpx rgba(42, 31, 23, 0.06),
    0 20rpx 38rpx -32rpx rgba(42, 31, 23, 0.24);
}

.loading-grid {
  position: relative;
  z-index: 2;
  display: grid;
  grid-template-columns: repeat(5, 20rpx);
  grid-auto-rows: 20rpx;
  gap: 8rpx;
}

.loading-cell {
  width: 20rpx;
  height: 20rpx;
  display: block;
  border-radius: 6rpx;
  background: var(--clay);
  box-shadow:
    inset 0 -2rpx 3rpx rgba(42, 31, 23, 0.18),
    inset 0 2rpx 2rpx rgba(255, 255, 255, 0.34);
  animation: loadingHop 1250ms ease-in-out infinite;
}

.loading-cell:nth-child(5n + 1) { background: var(--clay); animation-delay: 0ms; }
.loading-cell:nth-child(5n + 2) { background: var(--mint); animation-delay: 80ms; }
.loading-cell:nth-child(5n + 3) { background: var(--butter); animation-delay: 160ms; }
.loading-cell:nth-child(5n + 4) { background: var(--strawberry); animation-delay: 240ms; }
.loading-cell:nth-child(5n) { background: #8fb6d9; animation-delay: 320ms; }
.loading-cell:nth-child(7),
.loading-cell:nth-child(13),
.loading-cell:nth-child(19) {
  background: rgba(42, 31, 23, 0.1);
  box-shadow: inset 0 0 0 1rpx rgba(42, 31, 23, 0.05);
}

.loading-scan {
  position: absolute;
  left: 18rpx;
  right: 18rpx;
  top: 14rpx;
  z-index: 3;
  height: 34rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, rgba(255, 253, 248, 0.76), rgba(255, 253, 248, 0));
  animation: loadingScan 1500ms ease-in-out infinite;
}

@keyframes loadingHop {
  0%, 100% {
    opacity: 0.16;
    transform: translateY(0) scale(0.9);
  }
  50% {
    opacity: 1;
    transform: translateY(-6rpx) scale(1);
  }
}

@keyframes loadingScan {
  0% {
    opacity: 0;
    transform: translateY(-34rpx);
  }
  20% {
    opacity: 1;
  }
  100% {
    opacity: 0;
    transform: translateY(126rpx);
  }
}

.loading-pixels text:first-of-type {
  color: var(--foreground);
  font-size: 28rpx;
  font-weight: 900;
}

.loading-pixels text:last-of-type {
  color: var(--muted-foreground);
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1.45;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 64rpx 32rpx;
  border-radius: 34rpx;
  background: linear-gradient(180deg, rgba(255, 253, 248, 0.98), rgba(255, 250, 242, 0.98));
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.64),
    0 30rpx 64rpx -44rpx rgba(42, 31, 23, 0.2);
  text-align: center;
}

.empty-illust {
  display: grid;
  grid-template-columns: repeat(4, 24rpx);
  gap: 6rpx;
  padding: 20rpx;
  border-radius: 24rpx;
  background:
    linear-gradient(to right, rgba(217, 205, 179, 0.45) 1rpx, transparent 1rpx),
    linear-gradient(to bottom, rgba(217, 205, 179, 0.45) 1rpx, transparent 1rpx),
    rgba(197, 106, 76, 0.08);
  background-size: 18rpx 18rpx;
}

.empty-illust view {
  width: 24rpx;
  height: 24rpx;
  display: block;
  border-radius: 6rpx;
}

.empty-illust .on {
  background: var(--tone-color, var(--clay));
  animation: loadingHop 1600ms ease-in-out infinite;
}

.empty-illust .off {
  background: rgba(42, 31, 23, 0.1);
}

.empty-cta {
  min-width: 390rpx;
  height: 84rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 36rpx;
  margin-top: 12rpx;
  border-radius: 999rpx;
  background: var(--tone-color, var(--primary));
  color: #fffaf0;
  font-size: 26rpx;
  font-weight: 900;
  box-shadow: 0 22rpx 44rpx -30rpx rgba(197, 106, 76, 0.72);
}

.v0-empty-title {
  margin-top: 6rpx;
  color: var(--foreground);
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.2;
}

.v0-empty-sub {
  color: var(--muted-foreground);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.35;
}
