.icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  position: relative;
  color: inherit;
}

.i-arrow {
  width: 36%;
  height: 36%;
  border-top: 4rpx solid currentColor;
  border-right: 4rpx solid currentColor;
}
.i-arrow.left { transform: rotate(-135deg); margin-left: 12%; }
.i-arrow.right { transform: rotate(45deg); margin-right: 12%; }

.i-cross::before,
.i-cross::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 56%;
  height: 4rpx;
  background: currentColor;
  border-radius: 2rpx;
}
.i-cross::before { transform: translate(-50%, -50%) rotate(45deg); }
.i-cross::after { transform: translate(-50%, -50%) rotate(-45deg); }

.i-check {
  width: 40%;
  height: 22%;
  border-left: 4rpx solid currentColor;
  border-bottom: 4rpx solid currentColor;
  transform: rotate(-45deg);
  margin-top: -6%;
}
.i-check.sm {
  width: 36%;
  height: 20%;
  border-width: 3rpx;
}

.i-checkbox {
  width: 56%;
  height: 56%;
  border: 4rpx solid currentColor;
  border-radius: 6rpx;
  opacity: 0.5;
}
.i-checkbox.on {
  opacity: 1;
  background: currentColor;
  display: flex;
  align-items: center;
  justify-content: center;
}
.i-checkbox.on .i-check { border-color: #fff; }

.i-ruler {
  width: 60%;
  height: 36%;
  border: 3rpx solid currentColor;
  border-radius: 3rpx;
  position: relative;
}
.i-ruler::before {
  content: "";
  position: absolute;
  left: 20%;
  top: 0;
  width: 3rpx;
  height: 50%;
  background: currentColor;
}
.i-ruler::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 0;
  width: 3rpx;
  height: 70%;
  background: currentColor;
}

.i-eye {
  width: 56%;
  height: 36%;
  border: 3rpx solid currentColor;
  border-radius: 50%;
  position: relative;
}
.i-eye::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 30%;
  height: 30%;
  transform: translate(-50%, -50%);
  border-radius: 50%;
  background: currentColor;
}

.i-image {
  width: 56%;
  height: 46%;
  border: 3rpx solid currentColor;
  border-radius: 4rpx;
  position: relative;
  overflow: hidden;
}
.i-image::after {
  content: "";
  position: absolute;
  left: 10%;
  bottom: 10%;
  width: 80%;
  height: 40%;
  background: currentColor;
  opacity: 0.3;
  border-radius: 2rpx;
}

.i-crop {
  width: 50%;
  height: 50%;
  border-left: 4rpx solid currentColor;
  border-bottom: 4rpx solid currentColor;
  position: relative;
}
.i-crop::after {
  content: "";
  position: absolute;
  right: -4rpx;
  top: -4rpx;
  width: 100%;
  height: 100%;
  border-right: 4rpx solid currentColor;
  border-top: 4rpx solid currentColor;
}

.i-pipette {
  width: 4rpx;
  height: 56%;
  background: currentColor;
  border-radius: 2rpx;
  transform: rotate(-45deg);
  position: relative;
}
.i-pipette::after {
  content: "";
  position: absolute;
  bottom: -2rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 0;
  height: 0;
  border-left: 6rpx solid transparent;
  border-right: 6rpx solid transparent;
  border-top: 10rpx solid currentColor;
}

.i-star {
  width: 40%;
  height: 40%;
  background: currentColor;
  clip-path: polygon(50% 0%, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%);
}

.i-info {
  width: 56%;
  height: 56%;
  border: 3rpx solid currentColor;
  border-radius: 50%;
  position: relative;
}
.i-info::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 22%;
  width: 4rpx;
  height: 4rpx;
  transform: translateX(-50%);
  border-radius: 50%;
  background: currentColor;
}
.i-info::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 40%;
  width: 4rpx;
  height: 32%;
  transform: translateX(-50%);
  background: currentColor;
  border-radius: 2rpx;
}

.i-home {
  width: 50%;
  height: 44%;
  border: 3rpx solid currentColor;
  border-top: 0;
  border-radius: 0 0 4rpx 4rpx;
  position: relative;
}
.i-home::before {
  content: "";
  position: absolute;
  left: 50%;
  top: -50%;
  transform: translateX(-50%);
  width: 0;
  height: 0;
  border-left: 40% solid transparent;
  border-right: 40% solid transparent;
  border-bottom: 50% solid currentColor;
}

.i-save {
  width: 50%;
  height: 56%;
  border: 3rpx solid currentColor;
  border-radius: 4rpx;
  position: relative;
}
.i-save::after {
  content: "";
  position: absolute;
  left: 50%;
  bottom: 20%;
  width: 4rpx;
  height: 40%;
  transform: translateX(-50%);
  background: currentColor;
}

.i-trash {
  width: 44%;
  height: 52%;
  border: 3rpx solid currentColor;
  border-top: 0;
  border-radius: 0 0 4rpx 4rpx;
  position: relative;
}
.i-trash::before {
  content: "";
  position: absolute;
  left: -16%;
  top: -6rpx;
  width: 132%;
  height: 4rpx;
  background: currentColor;
  border-radius: 2rpx;
}

.i-edit {
  width: 4rpx;
  height: 56%;
  background: currentColor;
  border-radius: 2rpx;
  transform: rotate(-45deg);
}

.i-swap {
  width: 50%;
  height: 4rpx;
  background: currentColor;
  position: relative;
}
.i-swap::before,
.i-swap::after {
  content: "";
  position: absolute;
  width: 30%;
  height: 4rpx;
  background: currentColor;
}
.i-swap::before { right: 0; top: -30%; transform: rotate(40deg); transform-origin: right; }
.i-swap::after { right: 0; top: 30%; transform: rotate(-40deg); transform-origin: right; }

.i-zoom {
  width: 40%;
  height: 40%;
  border: 3rpx solid currentColor;
  border-radius: 50%;
  position: relative;
}
.i-zoom::before {
  content: "";
  position: absolute;
  right: -40%;
  bottom: -40%;
  width: 4rpx;
  height: 36%;
  background: currentColor;
  transform: rotate(-45deg);
  transform-origin: top;
}
.i-zoom.plus::after,
.i-zoom.minus::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 50%;
  height: 3rpx;
  transform: translate(-50%, -50%);
  background: currentColor;
}
.i-zoom.plus::after {
  box-shadow: 0 0 0 0 currentColor;
  height: 3rpx;
  width: 50%;
}

.i-share {
  width: 4rpx;
  height: 44%;
  background: currentColor;
  position: relative;
  transform: rotate(-45deg);
}
.i-share::after {
  content: "";
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 0;
  height: 0;
  border-left: 8rpx solid transparent;
  border-right: 8rpx solid transparent;
  border-bottom: 10rpx solid currentColor;
}
