<view class="screen tone-butter">
  <view class="app-header" style="{{navStyle}}">
    <view class="header-side">
      <button class="back-btn" bindtap="goHome"><icon name="back" size="32" /></button>
    </view>
    <view class="header-center">
      <view class="header-title">提取色号</view>
      <view class="header-subtitle">从已有图纸生成用豆清单</view>
    </view>
    <view class="header-side right">
      <button class="icon-btn" bindtap="goHome"><icon name="home" size="30" /></button>
    </view>
  </view>

  <scroll-view scroll-y enhanced="{{true}}" bounces="{{false}}" show-scrollbar="{{false}}" class="scroll-body flow-body extract-body">
    <button wx:if="{{!project}}" class="upload-panel" bindtap="chooseImage">
      <block wx:if="{{imagePath}}">
        <image class="upload-preview-image" src="{{imagePath}}" mode="aspectFit"></image>
        <view class="upload-preview-mask">
          <view>
            <view class="upload-title">已选择图纸</view>
            <view class="upload-sub">{{imageWidth}} x {{imageHeight}} · 点击换图</view>
          </view>
          <view class="upload-badge">更换</view>
        </view>
      </block>
      <block wx:else>
        <view class="upload-placeholder">
          <view class="placeholder-art">
            <view class="art-dot d1"></view>
            <view class="art-dot d2"></view>
            <view class="art-dot d3"></view>
            <view class="art-dot d4"></view>
            <view class="art-dot d5"></view>
            <view class="art-dot d6"></view>
            <view class="art-dot d7"></view>
            <view class="art-dot d8"></view>
            <view class="art-dot d9"></view>
          </view>
          <view class="upload-title">上传已有图纸</view>
          <view class="upload-sub">选择图纸后填写宽高</view>
        </view>
      </block>
    </button>

    <view wx:if="{{!project}}" class="card-feature extract-settings">
      <view class="v0-section-title compact-title">
        <text class="section-label">采样尺寸</text>
      </view>
      <view class="size-inputs">
        <view class="number-field">
          <view class="form-label">宽（颗）</view>
          <view class="number-input-wrap">
            <input class="number-input" type="number" value="{{width}}" bindinput="onWidthInput" />
          </view>
        </view>
        <view class="number-field">
          <view class="form-label">高（颗）</view>
          <view class="number-input-wrap">
            <input class="number-input" type="number" value="{{height}}" bindinput="onHeightInput" />
          </view>
        </view>
      </view>
      <picker mode="selector" range="{{paletteNames}}" value="{{paletteIndex}}" bindchange="onPaletteChange">
        <view class="palette-picker-row">
          <view>
            <view class="select-label">目标色卡</view>
            <view class="select-value">{{paletteNames[paletteIndex]}}</view>
          </view>
          <view class="select-arrow"><icon name="forward" size="28" /></view>
        </view>
      </picker>
    </view>

    <block wx:if="{{project}}">
      <view class="card-feature extract-summary">
        <view class="preview-stage">
          <canvas
            canvas-id="previewCanvas"
            class="preview-canvas"
            width="{{previewWidth}}"
            height="{{previewHeight}}"
            style="width: {{previewWidth}}px; height: {{previewHeight}}px;"
          ></canvas>
        </view>
        <view class="extract-summary-copy">
          <text>{{totalCount}} 颗 · {{project.colorStats.length}} 主色</text>
          <text>{{project.width}} x {{project.height}} · {{paletteNames[paletteIndex]}}</text>
        </view>
      </view>

      <view class="v0-section-title">
        <text class="section-label">色卡频率</text>
        <text class="section-action">占比从高到低</text>
      </view>

      <view class="freq-list">
        <view wx:for="{{colorStats}}" wx:key="statKey" class="freq-row">
          <view class="freq-swatch" style="background: {{item.hex}};"></view>
          <view class="freq-meta">
            <view class="freq-head">
              <text>{{item.name}}</text>
              <text>x{{item.count}}</text>
            </view>
            <view class="freq-track"><view style="width: {{item.percent}}%; background: {{item.hex}};"></view></view>
          </view>
          <text class="freq-ratio">{{item.percent}}%</text>
        </view>
      </view>

      <view class="v0-section-title">
        <text class="section-label">可匹配品牌</text>
      </view>

      <view class="palette-cards">
        <view wx:for="{{paletteOptions}}" wx:key="id" class="palette-card">
          <image class="palette-logo" src="{{item.icon}}" mode="aspectFit"></image>
          <view>
            <text>{{item.name}}</text>
            <text>{{item.count}} 色可匹配</text>
          </view>
          <text class="tag {{item.id === palettes[paletteIndex].id ? '' : 'tag-muted'}}">{{item.id === palettes[paletteIndex].id ? '当前' : '可选'}}</text>
        </view>
      </view>
    </block>
  </scroll-view>

  <view class="bottom-action-bar extract-actions">
    <button wx:if="{{!project}}" class="primary-action" loading="{{generating}}" bindtap="generate">
      <icon name="star" size="28" color="#fffaf0" />
      <text>{{generating ? '采样中' : '生成清单'}}</text>
    </button>
    <block wx:else>
      <button class="secondary-action" bindtap="copyList">复制清单</button>
      <button class="primary-action {{isSaved ? 'saved' : ''}}" loading="{{saving}}" bindtap="saveLocalProject">{{isSaved ? '打开作品' : '加入作品'}}</button>
    </block>
  </view>

  <canvas
    canvas-id="sourceCanvas"
    class="hidden-canvas"
    width="{{sourceCanvasWidth}}"
    height="{{sourceCanvasHeight}}"
    style="width: {{sourceCanvasWidth}}px; height: {{sourceCanvasHeight}}px;"
  ></canvas>
  <canvas
    canvas-id="reportCanvas"
    class="hidden-canvas"
    width="{{reportCanvasWidth}}"
    height="{{reportCanvasHeight}}"
    style="width: {{reportCanvasWidth}}px; height: {{reportCanvasHeight}}px;"
  ></canvas>
</view>
