.result-screen {
  height: 100vh;
  min-height: 0;
}

.result-body {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  padding-top: 20rpx;
}

.step-fill-3 {
  width: 100%;
}

.result-preview {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 28rpx;
}

.floating-chip.active {
  background: var(--tone-color);
}

.preview-scroll {
  position: relative;
  width: 100%;
  border-radius: 30rpx;
  background:
    linear-gradient(to right, rgba(217, 205, 179, 0.5) 1rpx, transparent 1rpx),
    linear-gradient(to bottom, rgba(217, 205, 179, 0.5) 1rpx, transparent 1rpx),
    #fbf6ec;
  background-size: 28rpx 28rpx;
}

.preview-canvas {
  display: block;
}

.original-overlay {
  position: absolute;
  left: 0;
  top: 0;
  z-index: 4;
  background: var(--warm-white);
  pointer-events: none;
}

.result-caption {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 18rpx;
  padding: 0 8rpx;
  color: var(--muted-foreground);
  font-size: 22rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
}

.result-caption text:first-child {
  color: var(--foreground);
}

.palette-row {
  white-space: nowrap;
  width: 100%;
}

.palette-pill {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  height: 88rpx;
  min-width: 0;
  margin-right: 14rpx;
  padding: 0 22rpx 0 14rpx;
  border-radius: 999rpx;
  background: var(--warm-white);
  box-shadow: inset 0 0 0 2rpx rgba(42, 31, 23, 0.08);
  color: var(--foreground);
  font-size: 24rpx;
  font-weight: 900;
  white-space: nowrap;
}

.palette-pill.active {
  color: var(--tone-color);
  background: rgba(197, 106, 76, 0.12);
  box-shadow: inset 0 0 0 2rpx rgba(197, 106, 76, 0.36);
}

.palette-logo {
  width: 56rpx;
  height: 56rpx;
  flex-shrink: 0;
  display: block;
  border-radius: 50%;
  background: #fffdf8;
  box-shadow: inset 0 0 0 1rpx rgba(42, 31, 23, 0.08);
}

.bead-list {
  overflow: hidden;
  border: 2rpx solid rgba(42, 31, 23, 0.07);
  border-radius: 30rpx;
  background: rgba(255, 253, 248, 0.7);
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.46);
}

.bead-row {
  display: flex;
  align-items: center;
  gap: 22rpx;
  min-height: 96rpx;
  padding: 18rpx 22rpx;
  border-bottom: 1rpx solid rgba(42, 31, 23, 0.07);
}

.bead-row:last-child {
  border-bottom: 0;
}

.bead-row.highlighted {
  background: rgba(197, 106, 76, 0.12);
}

.swatch {
  width: 62rpx;
  height: 62rpx;
  flex-shrink: 0;
  border-radius: 18rpx;
  box-shadow:
    inset 0 0 0 1rpx rgba(42, 31, 23, 0.14),
    inset 0 4rpx 6rpx rgba(255, 255, 255, 0.28);
}

.bead-main {
  flex: 1;
  min-width: 0;
}

.bead-code {
  color: var(--foreground);
  font-size: 26rpx;
  font-weight: 900;
}

.bead-name {
  margin-top: 6rpx;
  color: var(--muted-foreground);
  font-size: 22rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.bead-count {
  flex-shrink: 0;
  color: var(--tone-color);
  font-size: 28rpx;
  font-weight: 900;
}

.result-actions .secondary-action,
.result-actions .primary-action {
  min-width: 0;
}

.save-preview-mask {
  position: fixed;
  inset: 0;
  z-index: 20;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  background: rgba(42, 31, 23, 0.34);
}

.save-preview-panel {
  width: 100%;
  max-height: 86vh;
  box-sizing: border-box;
  padding: 22rpx 24rpx calc(22rpx + env(safe-area-inset-bottom));
  border-radius: 36rpx 36rpx 0 0;
  background: var(--background);
}

.save-preview-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 16rpx;
}

.close-preview {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--warm-white);
  color: var(--foreground);
  border: 2rpx solid var(--card-border);
}

.save-preview-scroll {
  max-height: 72vh;
  border: 2rpx solid rgba(42, 31, 23, 0.08);
  border-radius: 24rpx;
  background: #fffdf8;
}

.save-preview-image {
  display: block;
  width: 100%;
}

.empty-action {
  margin: 32rpx auto 0;
  width: 240rpx;
}
