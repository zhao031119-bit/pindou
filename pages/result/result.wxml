<view class="screen result-screen tone-clay">
  <block wx:if="{{project}}">
    <view class="app-header" style="{{navStyle}}">
      <view class="header-side">
        <button class="back-btn" bindtap="goBack"><icon name="back" size="32" /></button>
      </view>
      <view class="header-center">
        <view class="header-title">拼豆图纸</view>
        <view class="header-subtitle">{{project.width}} x {{project.height}} · {{project.colorStats.length}} 色</view>
      </view>
      <view class="header-side right">
      <button class="icon-btn" open-type="share" aria-label="share"><icon name="share" size="30" /></button>
      <button class="icon-btn" bindtap="goHome"><icon name="home" size="30" /></button>
    </view>
    </view>

    <scroll-view scroll-y enhanced="{{true}}" bounces="{{false}}" show-scrollbar="{{false}}" class="scroll-body flow-body result-body">
      <view class="step-indicator">
        <view class="step-meta">
          <text class="step-counter">03<text class="step-total">/ 03</text></text>
          <text class="step-current">图纸</text>
        </view>
        <view class="step-track"><view class="step-fill step-fill-3"></view></view>
      </view>

      <view class="card-feature result-preview">
        <button wx:if="{{sourceImage}}" class="floating-chip {{showOriginal ? 'active' : ''}}" bindtap="toggleOriginal">
          <icon name="eye" size="24" color="#fffdf8" />
          <text>{{showOriginal ? '图纸' : '原图'}}</text>
        </button>
        <scroll-view scroll-x scroll-y class="preview-scroll" style="height: {{previewBoxHeight}}px;">
          <canvas
            canvas-id="previewCanvas"
            class="preview-canvas"
            style="width: {{previewCanvasWidth}}px; height: {{previewCanvasHeight}}px;"
            width="{{previewCanvasWidth}}"
            height="{{previewCanvasHeight}}"
          ></canvas>
          <image
            wx:if="{{showOriginal && sourceImage}}"
            class="original-overlay"
            src="{{sourceImage}}"
            mode="aspectFit"
            style="width: {{previewCanvasWidth}}px; height: {{previewCanvasHeight}}px;"
          ></image>
        </scroll-view>
        <view class="result-caption">
          <text>{{project.width}} x {{project.height}} 颗 · {{project.colorStats.length}} 色</text>
          <text>合计 {{project.stats.total}} 颗</text>
        </view>
      </view>

      <view class="v0-section-title">
        <text class="section-label">可选色卡</text>
        <text class="section-action">{{palettes.length}} 个品牌</text>
      </view>

      <scroll-view scroll-x show-scrollbar="{{false}}" class="palette-row">
        <button
          wx:for="{{palettes}}"
          wx:key="id"
          class="palette-pill {{project.paletteId === item.id ? 'active' : ''}}"
          data-id="{{item.id}}"
          bindtap="switchPalette"
        >
          <image class="palette-logo" src="{{item.icon}}" mode="aspectFit"></image>
          <text>{{item.name}}</text>
        </button>
      </scroll-view>

      <view class="v0-section-title">
        <text class="section-label">豆子清单</text>
        <text class="section-action">{{project.stats.total}} 颗</text>
      </view>

      <view class="bead-list">
        <view
          wx:for="{{decoratedStats}}"
          wx:key="statKey"
          class="bead-row {{highlightCode === item.code ? 'highlighted' : ''}}"
          data-code="{{item.code}}"
          bindtap="highlightStat"
        >
          <view class="swatch" style="background: {{item.hex}};"></view>
          <view class="bead-main">
            <view class="bead-code">{{item.code}}</view>
            <view class="bead-name">{{item.name}} · {{item.hex}}</view>
          </view>
          <view class="bead-count">x{{item.count}}</view>
        </view>
      </view>

      <view wx:if="{{exportingPreview}}" class="loading-pixels">
        <view class="loading-board">
          <view class="loading-grid">
            <view class="loading-cell"></view><view class="loading-cell"></view><view class="loading-cell"></view><view class="loading-cell"></view><view class="loading-cell"></view>
            <view class="loading-cell"></view><view class="loading-cell"></view><view class="loading-cell"></view><view class="loading-cell"></view><view class="loading-cell"></view>
            <view class="loading-cell"></view><view class="loading-cell"></view><view class="loading-cell"></view><view class="loading-cell"></view><view class="loading-cell"></view>
            <view class="loading-cell"></view><view class="loading-cell"></view><view class="loading-cell"></view><view class="loading-cell"></view><view class="loading-cell"></view>
            <view class="loading-cell"></view><view class="loading-cell"></view><view class="loading-cell"></view><view class="loading-cell"></view><view class="loading-cell"></view>
          </view>
          <view class="loading-scan"></view>
        </view>
        <text>正在生成保存图</text>
        <text>生成预览后可长按保存</text>
      </view>
    </scroll-view>

    <view class="bottom-action-bar result-actions">
      <button class="secondary-action" loading="{{saving}}" bindtap="saveToProjects">
        <icon name="save" size="28" />
        <text>{{isSaved ? '打开作品' : '加入作品'}}</text>
      </button>
      <button class="primary-action" loading="{{exportingPreview}}" bindtap="saveLongImage">
        <icon name="share" size="28" color="#fffaf0" />
        <text>{{exportingPreview ? '生成中' : '保存图片'}}</text>
      </button>
    </view>

    <canvas
      canvas-id="exportCanvas"
      class="hidden-canvas"
      style="width: {{exportCanvasWidth}}px; height: {{exportCanvasHeight}}px;"
      width="{{exportCanvasWidth}}"
      height="{{exportCanvasHeight}}"
    ></canvas>

    <view wx:if="{{showSavePreview}}" class="save-preview-mask">
      <view class="save-preview-panel">
        <view class="save-preview-head">
          <view>
            <view class="section-title">保存预览</view>
            <view class="section-muted">长按图片保存到相册</view>
          </view>
          <button class="close-preview" bindtap="closeSavePreview"><icon name="close" size="28" /></button>
        </view>
        <scroll-view scroll-y class="save-preview-scroll">
          <image class="save-preview-image" src="{{exportPreviewPath}}" mode="widthFix" show-menu-by-longpress="{{true}}"></image>
        </scroll-view>
      </view>
    </view>
  </block>

  <block wx:else>
    <view class="app-header" style="{{navStyle}}">
      <view class="header-side">
        <button class="back-btn" bindtap="goHome"><icon name="back" size="32" /></button>
      </view>
      <view class="header-center">
        <view class="header-title">拼豆图纸</view>
        <view class="header-subtitle">先上传图片并确认尺寸</view>
      </view>
      <view class="header-side right">
      <button class="icon-btn" open-type="share" aria-label="share"><icon name="share" size="30" /></button>
      <button class="icon-btn" bindtap="goHome"><icon name="home" size="30" /></button>
    </view>
    </view>

    <scroll-view scroll-y enhanced="{{true}}" bounces="{{false}}" show-scrollbar="{{false}}" class="scroll-body flow-body result-body empty-result-body">
      <view class="card-feature empty-state result-empty">
        <view class="empty-illust">
          <view class="on"></view><view class="on"></view><view class="off"></view><view class="on"></view>
          <view class="on"></view><view class="off"></view><view class="on"></view><view class="on"></view>
          <view class="off"></view><view class="on"></view><view class="on"></view><view class="off"></view>
          <view class="on"></view><view class="on"></view><view class="off"></view><view class="on"></view>
        </view>
        <view class="v0-empty-title">还没有图纸</view>
        <view class="v0-empty-sub">请先上传图片并确认尺寸。</view>
        <button class="empty-cta" bindtap="goUpload">去上传</button>
      </view>
    </scroll-view>
  </block>
</view>
