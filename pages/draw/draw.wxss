.draw-page {
  height: 100vh;
  min-height: 0;
  box-sizing: border-box;
  padding: 72rpx 24rpx 28rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  background: var(--background);
  color: var(--foreground);
}

.topbar {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding: 12rpx;
  border: 2rpx solid var(--card-border);
  border-radius: 34rpx;
  background: var(--warm-white);
  box-shadow: 0 18rpx 42rpx -34rpx rgba(42, 31, 23, 0.16);
}

.draw-nav {
  flex-shrink: 0;
  display: flex;
  gap: 8rpx;
}

.round-icon {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #fbf8f2;
  color: var(--foreground);
  border: 2rpx solid var(--card-border);
}

.seg-scroll {
  flex: 1;
  min-width: 0;
  height: 66rpx;
  white-space: nowrap;
}

.seg {
  display: inline-flex;
  padding: 6rpx;
  border: 1rpx solid var(--card-border);
  border-radius: 999rpx;
  overflow: hidden;
  background: rgba(42, 31, 23, 0.05);
}

.seg-item {
  min-width: 96rpx;
  height: 54rpx;
  line-height: 54rpx;
  border-radius: 999rpx;
  text-align: center;
  font-size: 23rpx;
  color: var(--foreground);
}

.seg-item:last-child {
  border-right: 0;
}

.seg-item.active {
  background: var(--warm-white);
  color: var(--foreground);
  font-weight: 700;
  box-shadow: 0 2rpx 8rpx rgba(42, 31, 23, 0.08);
}

.zoom-text {
  flex-shrink: 0;
  min-width: 116rpx;
  text-align: right;
  color: var(--muted-foreground);
  font-size: 23rpx;
}

.canvas-wrap {
  flex-shrink: 0;
  margin-top: 18rpx;
  background: var(--warm-white);
  border: 2rpx solid var(--card-border);
  border-radius: 40rpx;
  overflow: hidden;
  box-shadow:
    0 2rpx 4rpx rgba(42, 31, 23, 0.03),
    0 24rpx 54rpx -30rpx rgba(42, 31, 23, 0.14);
}

.draw-canvas {
  display: block;
  margin: 0 auto;
}

.draw-controls-scroll {
  flex: 1;
  height: 0;
  min-height: 0;
  margin-top: 16rpx;
}

.toolbar,
.actions {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 10rpx;
  margin-top: 16rpx;
}

.draw-controls-scroll .toolbar {
  margin-top: 0;
}

.sub-toolbar {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 14rpx;
  padding: 16rpx;
  background: var(--warm-white);
  border: 2rpx solid var(--card-border);
  border-radius: 28rpx;
  box-shadow: 0 16rpx 36rpx -32rpx rgba(42, 31, 23, 0.16);
}

.sub-group {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.sub-label {
  color: var(--muted-foreground);
  font-size: 22rpx;
  margin-right: 4rpx;
}

.sub-chip {
  height: 50rpx;
  padding: 0 16rpx;
  display: inline-flex;
  align-items: center;
  border: 2rpx solid var(--card-border);
  border-radius: 999rpx;
  color: var(--foreground);
  font-size: 22rpx;
  font-weight: 600;
  background: var(--warm-white);
}

.sub-chip.active {
  border-color: var(--primary);
  background: rgba(197, 106, 76, 0.12);
  color: var(--primary);
}

.draft-status {
  margin-top: 10rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(127, 178, 154, 0.12);
  color: var(--accent);
  font-size: 20rpx;
  text-align: center;
}

.mini-btn.primary.saved {
  background: var(--accent);
  border-color: var(--accent);
  color: #ffffff;
}

.tool,
.mini-btn {
  height: 68rpx;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  border: 2rpx solid var(--card-border);
  background: var(--warm-white);
  color: var(--foreground);
  font-size: 22rpx;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.mini-btn.wide {
  font-size: 21rpx;
}

.tool.active,
.mini-btn.primary {
  border-color: var(--primary);
  background: var(--primary);
  color: var(--primary-foreground);
  font-weight: 700;
}

.mini-btn[disabled] {
  color: var(--muted-foreground);
  background: var(--secondary);
}

.palette-panel {
  margin-top: 18rpx;
  margin-bottom: 24rpx;
  background: var(--warm-white);
  border: 2rpx solid var(--card-border);
  border-radius: 36rpx;
  padding: 18rpx;
  box-shadow: 0 18rpx 42rpx -34rpx rgba(42, 31, 23, 0.16);
}

.palette-tabs {
  white-space: nowrap;
  height: 62rpx;
}

.palette-tab {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  height: 56rpx;
  padding: 0 16rpx 0 8rpx;
  margin-right: 10rpx;
  border: 2rpx solid var(--card-border);
  border-radius: 999rpx;
  color: var(--foreground);
  font-size: 23rpx;
  background: var(--warm-white);
}

.palette-tab-icon {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
  border-radius: 12rpx;
  background: #fbf8f2;
}

.palette-tab.active {
  border-color: var(--primary);
  color: var(--primary);
  background: rgba(197, 106, 76, 0.1);
}

.swatches {
  height: 254rpx;
  margin-top: 12rpx;
}

.swatch {
  position: relative;
  display: inline-flex;
  align-items: flex-end;
  justify-content: center;
  width: 74rpx;
  height: 74rpx;
  box-sizing: border-box;
  margin: 0 8rpx 8rpx 0;
  border: 3rpx solid rgba(42, 31, 23, 0.12);
  border-radius: 16rpx;
  overflow: hidden;
}

.swatch.active {
  border-color: #1f7a68;
  box-shadow: 0 0 0 3rpx rgba(31, 122, 104, 0.2);
}

.swatch text {
  width: 100%;
  line-height: 24rpx;
  text-align: center;
  font-size: 18rpx;
  color: #111111;
  background: rgba(255, 255, 255, 0.72);
}

.hidden-export {
  position: fixed;
  left: -9999px;
  top: -9999px;
}

/* v0 draw sync */
.draw-page {
  background:
    radial-gradient(ellipse 120% 86% at 50% 0%, rgba(208, 79, 63, 0.16) 0%, transparent 54%),
    var(--background);
}

.topbar {
  border-radius: 36rpx;
  background: rgba(255, 253, 248, 0.9);
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.72),
    0 30rpx 66rpx -48rpx rgba(42, 31, 23, 0.24);
}

.seg-item.active {
  color: var(--strawberry);
  font-weight: 850;
}

.canvas-wrap {
  border-radius: 46rpx;
  background:
    linear-gradient(to right, rgba(217, 205, 179, 0.5) 1rpx, transparent 1rpx),
    linear-gradient(to bottom, rgba(217, 205, 179, 0.5) 1rpx, transparent 1rpx),
    #fbf6ec;
  background-size: 28rpx 28rpx;
  box-shadow:
    0 4rpx 8rpx rgba(42, 31, 23, 0.03),
    0 42rpx 90rpx -56rpx rgba(42, 31, 23, 0.24);
}

.sub-toolbar,
.palette-panel {
  border-radius: 34rpx;
  background: linear-gradient(180deg, rgba(255, 253, 248, 0.98), rgba(255, 250, 242, 0.98));
}

.tool.active,
.mini-btn.primary {
  border-color: var(--strawberry);
  background: var(--strawberry);
  color: #fffaf0;
}

.sub-chip.active,
.palette-tab.active {
  border-color: var(--strawberry);
  background: rgba(208, 79, 63, 0.12);
  color: var(--strawberry);
}

.palette-tab-icon {
  border-radius: 50%;
}

.swatch {
  border-radius: 18rpx;
}

.draw-body {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  padding-top: 20rpx;
}

.draw-board {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx;
  overflow: hidden;
  background:
    linear-gradient(to right, rgba(217, 205, 179, 0.5) 1rpx, transparent 1rpx),
    linear-gradient(to bottom, rgba(217, 205, 179, 0.5) 1rpx, transparent 1rpx),
    #fbf6ec;
  background-size: 28rpx 28rpx;
}

.draw-canvas {
  display: block;
  max-width: 100%;
}

.draw-board.no-grid {
  background: var(--warm-white);
}

.tool-panel {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  padding: 18rpx;
  border-radius: 34rpx;
  background: var(--warm-white);
  box-shadow: inset 0 0 0 2rpx rgba(42, 31, 23, 0.07);
}

.tool-dock,
.tool-actions {
  display: grid;
  gap: 12rpx;
}

.tool-dock {
  grid-template-columns: repeat(5, minmax(0, 1fr));
}

.tool-actions {
  grid-template-columns: repeat(3, minmax(0, 1fr));
  padding-top: 14rpx;
  border-top: 2rpx solid rgba(42, 31, 23, 0.07);
}

.tool-dock .tool,
.tool-actions .tool {
  width: 100%;
  min-width: 0;
  height: 86rpx;
  padding: 8rpx 4rpx;
  flex-direction: column;
  gap: 4rpx;
  border: 2rpx solid transparent;
  border-radius: 24rpx;
  background: #fbf8f2;
  color: var(--foreground);
  font-size: 20rpx;
  font-weight: 900;
  box-shadow: inset 0 0 0 1rpx rgba(42, 31, 23, 0.04);
}

.tool-dock .tool.active,
.tool-actions .tool.active {
  border-color: rgba(208, 79, 63, 0.2);
  background: rgba(208, 79, 63, 0.14);
  color: var(--strawberry);
  box-shadow:
    inset 0 0 0 2rpx rgba(208, 79, 63, 0.16),
    0 12rpx 22rpx -18rpx rgba(208, 79, 63, 0.58);
}

.tool-icon {
  display: flex;
  flex-shrink: 0;
}

.tool-label {
  max-width: 100%;
  overflow: hidden;
  color: inherit;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tool-actions .tool.danger {
  color: #8d3a31;
}

.tool-dock .tool[disabled],
.tool-actions .tool[disabled] {
  opacity: 0.38;
}

.action-dock {
  gap: 16rpx;
}

.small-action {
  height: 78rpx;
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
}

.palette-row {
  white-space: nowrap;
  width: 100%;
}

.palette-pill {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  height: 82rpx;
  margin-right: 14rpx;
  padding: 0 22rpx 0 14rpx;
  border-radius: 999rpx;
  background: var(--warm-white);
  box-shadow: inset 0 0 0 2rpx rgba(42, 31, 23, 0.08);
  color: var(--foreground);
  font-size: 23rpx;
  font-weight: 900;
  white-space: nowrap;
}

.palette-pill.active {
  color: var(--strawberry);
  background: rgba(208, 79, 63, 0.12);
  box-shadow: inset 0 0 0 2rpx rgba(208, 79, 63, 0.36);
}

.palette-logo {
  width: 52rpx;
  height: 52rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: #fffdf8;
  box-shadow: inset 0 0 0 1rpx rgba(42, 31, 23, 0.08);
}

.color-dock {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  padding: 20rpx;
  border-radius: 34rpx;
  background: var(--warm-white);
  box-shadow: inset 0 0 0 2rpx rgba(42, 31, 23, 0.07);
}

.color-dot {
  width: 58rpx;
  height: 58rpx;
  flex-shrink: 0;
  border-radius: 50%;
  box-shadow:
    inset 0 -3rpx 5rpx rgba(42, 31, 23, 0.18),
    inset 0 3rpx 5rpx rgba(255, 255, 255, 0.32);
}

.color-dot.active {
  box-shadow:
    inset 0 -3rpx 5rpx rgba(42, 31, 23, 0.18),
    inset 0 3rpx 5rpx rgba(255, 255, 255, 0.32),
    0 0 0 5rpx var(--warm-white),
    0 0 0 8rpx var(--strawberry);
}
