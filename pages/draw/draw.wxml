<view class="screen tone-berry">
  <view class="app-header" style="{{navStyle}}">
    <view class="header-side">
      <button class="back-btn" bindtap="goBack"><icon name="back" size="32" /></button>
    </view>
    <view class="header-center">
      <view class="header-title">画豆图</view>
      <view class="header-subtitle">{{width}} x {{height}} · {{zoomLabel}}</view>
    </view>
    <view class="header-side right">
      <button class="icon-btn" bindtap="goHome"><icon name="home" size="30" /></button>
    </view>
  </view>

  <scroll-view scroll-y enhanced="{{true}}" bounces="{{false}}" show-scrollbar="{{false}}" class="scroll-body flow-body draw-body">
    <view wx:if="{{draftStatus}}" class="draft-status">{{draftStatus}}</view>

    <view class="card-feature draw-board">
      <canvas
        canvas-id="drawCanvas"
        class="draw-canvas"
        style="width: {{canvasSize}}px; height: {{canvasSize}}px;"
        width="{{canvasSize}}"
        height="{{canvasSize}}"
        bindtouchstart="onCanvasTouchStart"
        catchtouchmove="onCanvasTouchMove"
        bindtouchend="onCanvasTouchEnd"
        bindtouchcancel="onCanvasTouchEnd"
      ></canvas>
    </view>

    <view class="v0-section-title">
      <text class="section-label">工具</text>
      <text class="section-action">{{tool}}</text>
    </view>

    <view class="tool-dock">
      <button wx:for="{{tools}}" wx:key="id" class="tool {{tool === item.id ? 'active' : ''}}" data-tool="{{item.id}}" bindtap="chooseTool">{{item.label}}</button>
      <view class="tool-divider"></view>
      <button class="tool" bindtap="undo" disabled="{{!canUndo}}">撤</button>
      <button class="tool" bindtap="redo" disabled="{{!canRedo}}">重</button>
      <button class="tool" bindtap="resetView">居</button>
    </view>

    <view class="tool-dock action-dock">
      <button class="secondary-action small-action {{isSaved ? 'saved' : ''}}" loading="{{saving}}" bindtap="saveProject">{{isSaved ? '打开作品' : '加入作品'}}</button>
      <button class="primary-action small-action" bindtap="saveLongImage">保存图片</button>
    </view>

    <view class="v0-section-title">
      <text class="section-label">调色盘</text>
    </view>

    <scroll-view scroll-x class="palette-row" show-scrollbar="{{false}}">
      <button wx:for="{{palettes}}" wx:key="id" class="palette-pill {{paletteId === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="changePalette">
        <image class="palette-logo" src="{{item.icon}}" mode="aspectFit"></image>
        <text>{{item.name}}</text>
      </button>
    </scroll-view>

    <view class="color-dock">
      <button
        wx:for="{{colors}}"
        wx:key="id"
        class="color-dot {{selectedColor.id === item.id ? 'active' : ''}}"
        style="background: {{item.hex}};"
        data-index="{{index}}"
        bindtap="chooseColor"
      ></button>
    </view>
  </scroll-view>

  <canvas
    canvas-id="exportCanvas"
    class="hidden-export"
    style="width: {{exportWidth}}px; height: {{exportHeight}}px;"
    width="{{exportWidth}}"
    height="{{exportHeight}}"
  ></canvas>
</view>
