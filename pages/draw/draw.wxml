<view class="screen tone-berry">
  <view class="app-header" style="{{navStyle}}">
    <view class="header-side">
      <button class="back-btn" bindtap="goBack"><icon name="back" size="32" /></button>
    </view>
    <view class="header-center">
      <view class="header-title">画豆图</view>
      <view class="header-subtitle">{{width}} x {{height}} · {{zoomLabel}}</view>
    </view>
    <view class="header-side right">
      <button class="icon-btn" open-type="share" aria-label="share"><icon name="share" size="30" /></button>
      <button class="icon-btn" bindtap="goHome"><icon name="home" size="30" /></button>
    </view>
  </view>

  <scroll-view scroll-y enhanced="{{true}}" bounces="{{false}}" show-scrollbar="{{false}}" class="scroll-body flow-body draw-body">
    <view wx:if="{{draftStatus}}" class="draft-status">{{draftStatus}}</view>

    <view class="card-feature draw-board {{showGrid ? '' : 'no-grid'}}">
      <button class="floating-chip {{showGrid ? 'active' : ''}}" bindtap="toggleGrid">
        <icon name="grid" size="24" color="#fffdf8" />
        <text>网格</text>
      </button>
      <canvas
        canvas-id="drawCanvas"
        class="draw-canvas"
        style="width: {{canvasSize}}px; height: {{canvasSize}}px;"
        width="{{canvasSize}}"
        height="{{canvasSize}}"
        bindtouchstart="onCanvasTouchStart"
        catchtouchmove="onCanvasTouchMove"
        bindtouchend="onCanvasTouchEnd"
        bindtouchcancel="onCanvasTouchEnd"
      ></canvas>
    </view>

    <view class="v0-section-title">
      <text class="section-label">工具</text>
    </view>

    <view class="tool-panel">
      <view class="tool-dock">
        <button wx:for="{{tools}}" wx:key="id" class="tool {{tool === item.id ? 'active' : ''}}" data-tool="{{item.id}}" bindtap="chooseTool" aria-label="{{item.label}}">
          <icon class="tool-icon" name="{{item.icon}}" size="30" />
          <text class="tool-label">{{item.label}}</text>
        </button>
      </view>
      <view class="tool-actions">
        <button class="tool action-tool" bindtap="undo" disabled="{{!canUndo}}" aria-label="撤销">
          <icon class="tool-icon" name="undo" size="28" />
          <text class="tool-label">撤销</text>
        </button>
        <button class="tool action-tool" bindtap="redo" disabled="{{!canRedo}}" aria-label="重做">
          <icon class="tool-icon" name="redo" size="28" />
          <text class="tool-label">重做</text>
        </button>
        <button class="tool action-tool danger" bindtap="clearCanvas" aria-label="清空">
          <icon class="tool-icon" name="trash" size="28" />
          <text class="tool-label">清空</text>
        </button>
      </view>
    </view>

    <view class="v0-section-title">
      <text class="section-label">调色盘</text>
    </view>

    <view class="brand-grid">
      <button wx:for="{{palettes}}" wx:key="id" class="brand-tile {{paletteId === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="changePalette">
        <view class="brand-avatar">
          <image class="palette-logo" src="{{item.icon}}" mode="aspectFit"></image>
        </view>
        <text>{{item.name}}</text>
      </button>
    </view>

    <view class="color-dock">
      <button
        wx:for="{{colors}}"
        wx:key="id"
        class="color-dot {{selectedColor.id === item.id ? 'active' : ''}}"
        style="background: {{item.hex}};"
        data-index="{{index}}"
        bindtap="chooseColor"
      ></button>
    </view>
  </scroll-view>

  <canvas
    canvas-id="exportCanvas"
    class="hidden-export"
    style="width: {{exportWidth}}px; height: {{exportHeight}}px;"
    width="{{exportWidth}}"
    height="{{exportHeight}}"
  ></canvas>
</view>
