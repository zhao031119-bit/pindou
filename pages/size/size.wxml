<view class="screen tone-butter">
  <view class="app-header" style="{{navStyle}}">
    <view class="header-side">
      <button class="back-btn" bindtap="goCrop"><icon name="back" size="32" /></button>
    </view>
    <view class="header-center">
      <view class="header-title">确认尺寸</view>
      <view class="header-subtitle">{{width}} x {{height}} · {{stats.total}} 颗</view>
    </view>
    <view class="header-side right">
      <button class="icon-btn" open-type="share" aria-label="share"><icon name="share" size="30" /></button>
      <button class="icon-btn" bindtap="goHome"><icon name="home" size="30" /></button>
    </view>
  </view>

  <scroll-view scroll-y enhanced="{{true}}" bounces="{{false}}" show-scrollbar="{{false}}" class="scroll-body flow-body size-body">
    <view class="step-indicator">
      <view class="step-meta">
        <text class="step-counter">02<text class="step-total">/ 03</text></text>
        <text class="step-current">尺寸</text>
      </view>
      <view class="step-track"><view class="step-fill step-fill-2"></view></view>
    </view>

    <view class="card-feature size-hero">
      <view class="size-hero-stat">
        <text class="hero-label">预计颗数</text>
        <text class="hero-number">{{stats.total}}</text>
        <text class="hero-note">{{stats.physicalWidthCm}} x {{stats.physicalHeightCm}} cm</text>
      </view>
      <view class="size-hero-aside">
        <text class="hero-label">预计价格</text>
        <text class="hero-price">¥{{estimatedPrice}}</text>
      </view>
    </view>

    <view class="v0-section-title">
      <text class="section-label">尺寸</text>
    </view>

    <view class="size-inputs">
      <view class="size-input-label">
        <text>宽（颗）</text>
        <view class="stepper">
          <button data-field="width" data-delta="-1" bindtap="stepDimension">−</button>
          <input type="number" value="{{width}}" bindinput="onWidthInput" />
          <button data-field="width" data-delta="1" bindtap="stepDimension">+</button>
        </view>
      </view>
      <view class="size-input-label">
        <text>高（颗）</text>
        <view class="stepper">
          <button data-field="height" data-delta="-1" bindtap="stepDimension">−</button>
          <input type="number" value="{{height}}" bindinput="onHeightInput" />
          <button data-field="height" data-delta="1" bindtap="stepDimension">+</button>
        </view>
      </view>
    </view>

    <view class="v0-section-title">
      <text class="section-label">尺寸预设</text>
    </view>

    <view class="recommend-row">
      <button
        wx:for="{{simplePresets}}"
        wx:key="id"
        class="recommend {{selectedPresetId === item.id ? 'active' : ''}}"
        data-index="{{index}}"
        bindtap="applySimplePreset"
      >
        <text class="recommend-title">{{item.label}}</text>
        <text class="recommend-size">{{item.width}} x {{item.height}}</text>
      </button>
    </view>

    <view class="v0-section-title">
      <text class="section-label">比例预览</text>
      <text class="section-action">{{width}} x {{height}}</text>
    </view>

    <view class="card-feature preview-board">
      <text class="board-ratio">{{width}} x {{height}}</text>
      <view class="ghost-grid" style="{{previewStyle}}"></view>
    </view>

    <view wx:if="{{generating}}" class="loading-pixels">
      <view class="loading-board">
        <view class="loading-grid">
          <view class="loading-cell"></view><view class="loading-cell"></view><view class="loading-cell"></view><view class="loading-cell"></view><view class="loading-cell"></view>
          <view class="loading-cell"></view><view class="loading-cell"></view><view class="loading-cell"></view><view class="loading-cell"></view><view class="loading-cell"></view>
          <view class="loading-cell"></view><view class="loading-cell"></view><view class="loading-cell"></view><view class="loading-cell"></view><view class="loading-cell"></view>
          <view class="loading-cell"></view><view class="loading-cell"></view><view class="loading-cell"></view><view class="loading-cell"></view><view class="loading-cell"></view>
          <view class="loading-cell"></view><view class="loading-cell"></view><view class="loading-cell"></view><view class="loading-cell"></view><view class="loading-cell"></view>
        </view>
        <view class="loading-scan"></view>
      </view>
      <text>{{generateStage || '正在生成图纸'}}</text>
      <text>像素聚类、色号匹配、生成清单...</text>
    </view>
  </scroll-view>

  <view class="bottom-action-bar">
    <button class="primary-action" loading="{{generating}}" bindtap="generatePattern">
      <icon name="star" size="28" color="#fffaf0" />
      <text>{{generating ? '生成中' : '生成图纸'}}</text>
    </button>
  </view>

  <canvas
    class="hidden-canvas generator-canvas"
    canvas-id="sourceCanvas"
    style="width: {{canvasWidth}}px; height: {{canvasHeight}}px;"
    width="{{canvasWidth}}"
    height="{{canvasHeight}}"
  ></canvas>
</view>
