.size-body {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  padding-top: 24rpx;
}

.step-fill-2 {
  width: 66.666%;
}

.size-hero {
  display: flex;
  align-items: stretch;
  justify-content: space-between;
  gap: 28rpx;
  padding: 40rpx 44rpx;
}

.size-hero-stat {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.size-hero-aside {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: space-between;
  flex-shrink: 0;
  text-align: right;
}

.hero-label {
  color: var(--muted-foreground);
  font-size: 20rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
}

.hero-number {
  margin-top: 8rpx;
  color: var(--foreground);
  font-size: 72rpx;
  font-weight: 900;
  line-height: 1;
}

.hero-note {
  margin-top: 12rpx;
  color: var(--muted-foreground);
  font-size: 24rpx;
  font-weight: 800;
}

.hero-price {
  margin-top: auto;
  color: var(--tone-color);
  font-size: 44rpx;
  font-weight: 900;
}

.size-inputs {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
}

.size-input-label {
  display: grid;
  gap: 12rpx;
  min-width: 0;
  color: var(--muted-foreground);
  font-size: 24rpx;
  font-weight: 900;
}

.stepper {
  display: grid;
  grid-template-columns: 72rpx 1fr 72rpx;
  align-items: stretch;
  height: 104rpx;
  overflow: hidden;
  border: 2rpx solid rgba(42, 31, 23, 0.08);
  border-radius: 32rpx;
  background: #fffdf8;
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.56);
}

.stepper button {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--muted-foreground);
  font-size: 34rpx;
  font-weight: 900;
}

.stepper input {
  width: 100%;
  height: 100%;
  border: 0;
  background: transparent;
  color: var(--foreground);
  text-align: center;
  font-size: 40rpx;
  font-weight: 900;
}

.recommend-row {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  align-items: stretch;
  gap: 24rpx;
}

.recommend {
  min-width: 0;
  min-height: 140rpx;
  display: grid;
  grid-template-rows: auto auto;
  align-content: center;
  justify-items: center;
  gap: 12rpx;
  padding: 24rpx 12rpx;
  overflow: hidden;
  border-radius: 30rpx;
  background: var(--warm-white);
  box-shadow:
    inset 0 0 0 2rpx rgba(42, 31, 23, 0.07),
    0 18rpx 34rpx -30rpx rgba(42, 31, 23, 0.18);
  text-align: center;
}

.recommend.active {
  color: var(--clay);
  background: rgba(197, 106, 76, 0.11);
  box-shadow:
    inset 0 0 0 2rpx rgba(197, 106, 76, 0.34),
    0 20rpx 36rpx -30rpx rgba(197, 106, 76, 0.5);
}

.recommend-title,
.recommend-size {
  display: block;
  max-width: 100%;
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recommend-title {
  color: var(--foreground);
  font-size: 28rpx;
  font-weight: 900;
}

.recommend-size {
  color: var(--muted-foreground);
  font-size: 23rpx;
  font-weight: 800;
}

.recommend.active .recommend-title,
.recommend.active .recommend-size {
  color: var(--clay);
}

.preview-board {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 440rpx;
  padding: 44rpx;
  background: var(--warm-white);
}

.board-ratio {
  position: absolute;
  left: 32rpx;
  top: 28rpx;
  color: var(--muted-foreground);
  font-size: 24rpx;
  font-weight: 900;
}

.ghost-grid {
  border-radius: 40rpx;
  background:
    linear-gradient(to right, rgba(42, 31, 23, 0.1) 1rpx, transparent 1rpx),
    linear-gradient(to bottom, rgba(42, 31, 23, 0.1) 1rpx, transparent 1rpx),
    #fbf6ec;
  background-size: 24rpx 24rpx;
}

.generator-canvas {
  width: 10px;
  height: 10px;
}

.generate-stage-bar {
  margin: 0 32rpx 12rpx;
  padding: 14rpx 20rpx;
  border-radius: 18rpx;
  background: rgba(232, 182, 73, 0.16);
  color: #9a7423;
  font-size: 24rpx;
  font-weight: 800;
  text-align: center;
  animation: stageFade 0.6s ease-in-out infinite alternate;
}

@keyframes stageFade {
  from { opacity: 0.7; }
  to { opacity: 1; }
}
