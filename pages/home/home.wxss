/* miniprogram/pages/home/home.wxss — Bento 首页 (750rpx = 屏宽) */

.page {
  min-height: 100vh;
  padding: 0 0 60rpx;
  overflow-x: hidden;
}

/* ===== 品牌识别小条 ===== */
.brand {
  display: flex;
  align-items: center;
  padding: 20rpx 40rpx 0;
}
.brand-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: var(--clay);
  box-shadow:
    inset 0 -2rpx 2rpx rgba(0,0,0,0.15),
    inset 0 2rpx 2rpx rgba(255,255,255,0.4),
    0 2rpx 3rpx rgba(42,31,23,0.15);
}
.brand-text {
  margin-left: 14rpx;
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 0;
  color: var(--cocoa);
  opacity: 0.42;
}

.home-share-btn {
  width: 64rpx;
  height: 64rpx;
  margin-left: auto;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(42, 31, 23, 0.06);
  border-radius: 50%;
  background: rgba(255, 253, 248, 0.88);
  color: var(--charcoal);
  box-shadow: 0 18rpx 38rpx -30rpx rgba(42, 31, 23, 0.34);
}

/* ===== 大标题 ===== */
.header {
  padding: 28rpx 40rpx 0;
}
.greeting {
  display: block;
  font-size: 24rpx;
  font-weight: 500;
  color: var(--silver-warm);
  letter-spacing: 0;
}
.title {
  margin-top: 6rpx;
  font-size: 56rpx;
  font-weight: 800;
  line-height: 1.15;
  letter-spacing: 0;
  color: var(--charcoal);
}
.title-accent {
  color: var(--clay);
}

/* ===== Bento 宫格 ===== */
.bento {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 0;
  padding: 40rpx 40rpx 0;
}

.card {
  position: relative;
  box-sizing: border-box;
  overflow: hidden;
  background: var(--warm-white);
  border: 2rpx solid var(--card-border);
  border-radius: 44rpx;
  box-shadow:
    0 2rpx 4rpx rgba(42,31,23,0.03),
    0 28rpx 60rpx -28rpx rgba(42,31,23,0.13);
  transition: transform 0.18s ease, box-shadow 0.18s ease;
  margin-bottom: 20rpx;
}
.card-press {
  transform: scale(0.97);
  box-shadow:
    0 2rpx 4rpx rgba(42,31,23,0.04),
    0 8rpx 20rpx -8rpx rgba(42,31,23,0.09);
}

.card-hero {
  width: 100%;
  flex: 0 0 100%;
  height: 300rpx;
  padding: 40rpx;
}
.card-square {
  width: 325rpx;
  flex: 0 0 325rpx;
  height: 328rpx;
  padding: 32rpx;
}
.card-wide {
  width: 100%;
  flex: 0 0 100%;
  height: 208rpx;
  padding: 24rpx 32rpx;
  display: flex;
  align-items: center;
}

/* 卡内文字容器 */
.card-inner {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  height: 100%;
}
.inner-hero { max-width: 50%; }
.inner-wide { max-width: 55%; }

.accent-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-bottom: 12rpx;
}
.dot-clay       { background: var(--clay);       box-shadow: 0 0 12rpx rgba(197,106,76,0.55); }
.dot-mint       { background: var(--mint);       box-shadow: 0 0 12rpx rgba(127,178,154,0.55); }
.dot-butter     { background: var(--butter);     box-shadow: 0 0 12rpx rgba(232,182,73,0.55); }
.dot-strawberry { background: var(--strawberry); box-shadow: 0 0 12rpx rgba(208,79,63,0.55); }

.card-title {
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.2;
  letter-spacing: 0;
  color: var(--charcoal);
}
.title-hero { font-size: 44rpx; }

.card-subtitle {
  margin-top: 4rpx;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1.4;
  letter-spacing: 0;
  color: var(--silver-warm);
}

/* 柔光圆盘 */
.card-glow {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
  z-index: 0;
}
.glow-hero {
  width: 480rpx; height: 480rpx;
  right: -140rpx; bottom: -140rpx;
  background: radial-gradient(circle, rgba(208,79,63,0.20) 0%, transparent 62%);
}
.glow-mint {
  width: 320rpx; height: 320rpx;
  right: -100rpx; bottom: -100rpx;
  background: radial-gradient(circle, rgba(127,178,154,0.22) 0%, transparent 62%);
}
.glow-butter {
  width: 320rpx; height: 320rpx;
  right: -100rpx; bottom: -100rpx;
  background: radial-gradient(circle, rgba(232,182,73,0.24) 0%, transparent 62%);
}
.glow-strawberry {
  width: 340rpx; height: 340rpx;
  right: -100rpx; top: 50%;
  transform: translateY(-50%);
  background: radial-gradient(circle, rgba(197,106,76,0.18) 0%, transparent 62%);
}

/* 像素插画 */
.card-asset {
  position: absolute;
  z-index: 1;
  pointer-events: none;
  opacity: 0.96;
  image-rendering: pixelated;
}

.asset-generate {
  width: 404rpx;
  height: 292rpx;
  right: -30rpx;
  top: 4rpx;
}

.asset-pick,
.asset-extract {
  width: 256rpx;
  height: 185rpx;
  right: -22rpx;
  top: 24rpx;
}

.asset-draw {
  width: 300rpx;
  height: 216rpx;
  right: 4rpx;
  top: 50%;
  transform: translateY(-50%);
}

.illo {
  position: absolute;
  pointer-events: none;
  z-index: 1;
  filter: drop-shadow(0 4rpx 8rpx rgba(42,31,23,0.12));
}
.illo-hero {
  width: 248rpx; height: 248rpx;
  right: -12rpx; bottom: -16rpx;
}
.illo-square {
  width: 168rpx; height: 168rpx;
  right: -16rpx; bottom: -20rpx;
}
.illo-wide {
  width: 172rpx; height: 172rpx;
  right: 16rpx; top: 50%;
  transform: translateY(-50%);
}

.home-art {
  overflow: visible;
}

.art-strawberry .berry,
.art-strawberry .leaf,
.art-beads .big-bead,
.art-grid .grid-bead,
.mini-art .mini-dot,
.works-thumb .thumb-dot {
  position: absolute;
  border-radius: 50%;
  box-shadow:
    inset 0 -3rpx 5rpx rgba(42,31,23,0.16),
    inset 0 3rpx 5rpx rgba(255,255,255,0.36),
    0 4rpx 8rpx rgba(42,31,23,0.08);
}

.art-strawberry .berry {
  width: 50rpx;
  height: 50rpx;
  background: #D04F3F;
}
.art-strawberry .leaf {
  width: 42rpx;
  height: 30rpx;
  background: #7FB29A;
  border-radius: 50% 50% 12rpx 12rpx;
}
.art-strawberry .leaf-1 { left: 78rpx; top: 12rpx; transform: rotate(-28deg); }
.art-strawberry .leaf-2 { left: 118rpx; top: 10rpx; transform: rotate(24deg); background: #5E9376; }
.art-strawberry .berry-1 { left: 86rpx; top: 48rpx; }
.art-strawberry .berry-2 { left: 48rpx; top: 84rpx; background: #E36558; }
.art-strawberry .berry-3 { left: 122rpx; top: 84rpx; }
.art-strawberry .berry-4 { left: 76rpx; top: 122rpx; background: #C84638; }
.art-strawberry .berry-5 { left: 116rpx; top: 128rpx; background: #B83C30; }
.art-strawberry .berry-6 { left: 92rpx; top: 166rpx; background: #A83828; }
.art-strawberry .seed {
  width: 16rpx;
  height: 16rpx;
  background: #FBF6EC;
  opacity: 0.85;
}
.art-strawberry .seed-1 { left: 76rpx; top: 112rpx; }
.art-strawberry .seed-2 { left: 140rpx; top: 122rpx; }

.art-cards .color-card {
  position: absolute;
  width: 42rpx;
  height: 118rpx;
  border-radius: 14rpx;
  box-shadow:
    inset 0 0 0 2rpx rgba(255,255,255,0.36),
    0 8rpx 18rpx rgba(42,31,23,0.13);
}
.art-cards .color-card::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 16rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  transform: translateX(-50%);
  background: rgba(255,255,255,0.62);
}
.card-a { left: 18rpx; top: 48rpx; transform: rotate(-13deg); background: #C56A4C; }
.card-b { left: 64rpx; top: 34rpx; background: #7FB29A; }
.card-c { left: 108rpx; top: 48rpx; transform: rotate(13deg); background: #E8B649; }

.art-beads .big-bead {
  width: 62rpx;
  height: 62rpx;
}
.art-beads .bead-a { left: 10rpx; top: 44rpx; background: #D04F3F; }
.art-beads .bead-b { left: 74rpx; top: 24rpx; background: #E8B649; }
.art-beads .bead-c { left: 98rpx; top: 92rpx; background: #7FB29A; }
.art-beads .bead-d { left: 32rpx; top: 108rpx; background: #C56A4C; }
.art-beads .big-bead::after {
  content: "";
  position: absolute;
  left: 18rpx;
  top: 14rpx;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.5);
}

.art-grid {
  border-radius: 24rpx;
  background:
    linear-gradient(to right, rgba(217,205,179,0.6) 1rpx, transparent 1rpx),
    linear-gradient(to bottom, rgba(217,205,179,0.6) 1rpx, transparent 1rpx);
  background-size: 34rpx 34rpx;
}
.art-grid .grid-bead {
  width: 26rpx;
  height: 26rpx;
  background: #D04F3F;
}
.gb-1 { left: 36rpx; top: 36rpx; }
.gb-2 { left: 104rpx; top: 36rpx; }
.gb-3 { left: 70rpx; top: 70rpx; }
.gb-4 { left: 36rpx; top: 70rpx; }
.gb-5 { left: 104rpx; top: 70rpx; }
.gb-6 { left: 70rpx; top: 104rpx; background: #A83828 !important; }

/* ===== 草稿宽卡 ===== */
.draft-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin: 40rpx 40rpx 0;
  padding: 24rpx;
  background: var(--warm-white);
  border: 2rpx solid var(--card-border);
  border-radius: 40rpx;
  box-shadow:
    0 2rpx 4rpx rgba(42,31,23,0.03),
    0 20rpx 44rpx -20rpx rgba(42,31,23,0.11);
  transition: transform 0.18s ease, box-shadow 0.18s ease;
}

.draft-thumb-wrap {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  flex-shrink: 0;
  border-radius: 24rpx;
  background-color: var(--cream);
  box-shadow:
    inset 0 0 0 2rpx rgba(42,31,23,0.05),
    0 2rpx 4rpx rgba(42,31,23,0.06);
}
.draft-thumb {
  position: relative;
  width: 100%; height: 100%;
  border-radius: 24rpx;
}
.draft-thumb-image {
  display: block;
  background: var(--cream);
}
.draft-thumb-grid {
  display: grid;
  gap: 2rpx;
  box-sizing: border-box;
  padding: 8rpx;
  overflow: hidden;
  margin: auto;
  background:
    linear-gradient(to right, rgba(217,205,179,0.4) 1rpx, transparent 1rpx),
    linear-gradient(to bottom, rgba(217,205,179,0.4) 1rpx, transparent 1rpx),
    #FBF6EC;
  background-size: 18rpx 18rpx;
}
.draft-dot {
  border-radius: 50%;
  box-shadow:
    inset 0 -2rpx 3rpx rgba(42,31,23,0.14),
    inset 0 2rpx 3rpx rgba(255,255,255,0.35);
}
.draft-dot.empty {
  background: rgba(255,255,255,0.68) !important;
  box-shadow: inset 0 0 0 1rpx rgba(42,31,23,0.08);
}
.mini-art {
  overflow: hidden;
  background:
    linear-gradient(to right, rgba(217,205,179,0.55) 1rpx, transparent 1rpx),
    linear-gradient(to bottom, rgba(217,205,179,0.55) 1rpx, transparent 1rpx),
    #FBF6EC;
  background-size: 24rpx 24rpx;
}
.mini-dot {
  width: 22rpx;
  height: 22rpx;
  background: #D04F3F;
}
.md-1 { left: 37rpx; top: 15rpx; background: #7FB29A !important; }
.md-2 { left: 24rpx; top: 38rpx; }
.md-3 { left: 48rpx; top: 38rpx; }
.md-4 { left: 32rpx; top: 60rpx; background: #C84638 !important; }
.md-5 { left: 55rpx; top: 60rpx; background: #A83828 !important; }
.draft-pulse {
  position: absolute;
  top: -6rpx; right: -6rpx;
  width: 22rpx; height: 22rpx;
  border-radius: 50%;
  background: var(--clay);
  box-shadow:
    0 0 0 4rpx var(--warm-white),
    0 0 16rpx rgba(197,106,76,0.55);
  animation: pulseSoft 1.8s ease-in-out infinite;
}
@keyframes pulseSoft {
  0%, 100% { opacity: 1; }
  50%      { opacity: 0.55; }
}

.draft-meta { flex: 1; min-width: 0; }
.draft-eyebrow {
  display: block;
  font-size: 18rpx;
  font-weight: 600;
  letter-spacing: 0;
  color: var(--clay);
  text-transform: uppercase;
}
.draft-title {
  margin-top: 4rpx;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 0;
  color: var(--charcoal);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.draft-progress-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 12rpx;
}
.draft-progress {
  position: relative;
  flex: 1;
  height: 8rpx;
  background: rgba(42,31,23,0.07);
  border-radius: 999rpx;
  overflow: hidden;
}
.draft-progress-fill {
  position: absolute;
  top: 0; bottom: 0; left: 0;
  background: linear-gradient(90deg, var(--clay) 0%, var(--clay-soft) 100%);
  border-radius: 999rpx;
  box-shadow: 0 0 12rpx rgba(197,106,76,0.45);
}
.draft-remain {
  flex: 1;
  min-width: 0;
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 0;
  color: var(--silver-warm);
  font-variant-numeric: tabular-nums;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ===== Chevron 圆形 ===== */
.chev {
  flex-shrink: 0;
  width: 56rpx; height: 56rpx;
  border-radius: 50%;
  background: rgba(42,31,23,0.05);
  box-shadow: inset 0 0 0 2rpx rgba(42,31,23,0.04);
  display: flex;
  align-items: center;
  justify-content: center;
}
.chev-arrow {
  width: 14rpx; height: 14rpx;
  border-top: 3rpx solid #A0917C;
  border-right: 3rpx solid #A0917C;
  transform: rotate(45deg);
  margin-left: -4rpx;
}

/* ===== 作品卡 ===== */
.works-card {
  margin: 20rpx 40rpx 0;
  padding: 32rpx;
  background: var(--warm-white);
  border: 2rpx solid var(--card-border);
  border-radius: 40rpx;
  box-shadow:
    0 2rpx 4rpx rgba(42,31,23,0.03),
    0 20rpx 44rpx -20rpx rgba(42,31,23,0.11);
}
.works-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.works-title-row {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
}
.works-title {
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 0;
  color: var(--charcoal);
}
.works-count {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--silver-warm);
  font-variant-numeric: tabular-nums;
}
.works-thumbs {
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.works-thumb {
  position: relative;
  width: 72rpx; height: 72rpx;
  flex-shrink: 0;
  border-radius: 20rpx;
  background-color: var(--cream);
  overflow: hidden;
  box-shadow:
    inset 0 0 0 2rpx rgba(42,31,23,0.05),
    0 2rpx 4rpx rgba(42,31,23,0.05);
}
.works-thumb-grid {
  display: grid;
  gap: 1rpx;
  padding: 6rpx;
  margin: auto;
  background: #FBF6EC;
}
.works-thumb-cell {
  border-radius: 50%;
  box-shadow:
    inset 0 -1rpx 2rpx rgba(42,31,23,0.13),
    inset 0 1rpx 2rpx rgba(255,255,255,0.32);
}
.works-thumb-cell.empty {
  background: rgba(255,255,255,0.7) !important;
  box-shadow: inset 0 0 0 1rpx rgba(42,31,23,0.08);
}
.thumb-dot {
  width: 20rpx;
  height: 20rpx;
}
.td-1 { left: 13rpx; top: 16rpx; }
.td-2 { left: 38rpx; top: 16rpx; }
.td-3 { left: 26rpx; top: 40rpx; }
.works-all {
  margin-left: auto;
  height: 72rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: rgba(42,31,23,0.05);
  display: flex;
  align-items: center;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 0;
  color: var(--silver-warm);
}

.bottom-pad { height: 60rpx; }

