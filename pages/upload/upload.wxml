<view class="screen tone-sky">
  <view class="app-header" style="{{navStyle}}">
    <view class="header-side">
      <button class="back-btn" bindtap="goBack"><icon name="back" size="32" /></button>
    </view>
    <view class="header-center">
      <view class="header-title">裁剪图片</view>
      <view class="header-subtitle">拖动图片 · 双指缩放</view>
    </view>
    <view class="header-side right">
      <button class="icon-btn" bindtap="goHome"><icon name="home" size="30" /></button>
    </view>
  </view>

  <scroll-view scroll-y enhanced="{{true}}" bounces="{{false}}" show-scrollbar="{{false}}" class="scroll-body flow-body upload-body">
    <view class="step-indicator">
      <view class="step-meta">
        <text class="step-counter">01<text class="step-total">/ 03</text></text>
        <text class="step-current">裁剪</text>
      </view>
      <view class="step-track"><view class="step-fill step-fill-1"></view></view>
    </view>

    <view class="card-feature crop-stage">
      <view
        class="photo-surface crop-shell"
        style="width: {{stageWidth}}px; height: {{stageHeight}}px;"
        catchtouchstart="onCropStart"
        catchtouchmove="onCropMove"
        catchtouchend="onCropEnd"
        catchtouchcancel="onCropEnd"
      >
        <block wx:if="{{imagePath}}">
          <image
            class="crop-photo"
            src="{{imagePath}}"
            mode="scaleToFill"
            style="left: {{imageRect.x}}px; top: {{imageRect.y}}px; width: {{imageRect.width}}px; height: {{imageRect.height}}px;"
          ></image>
          <view class="crop-frame">
            <view class="crop-corner top-left"></view>
            <view class="crop-corner top-right"></view>
            <view class="crop-corner bottom-left"></view>
            <view class="crop-corner bottom-right"></view>
          </view>
          <button class="floating-chip" catchtap="replaceImage">
            <icon name="swap" size="24" color="#fffdf8" />
            <text>换图</text>
          </button>
        </block>
        <button wx:else class="mock-photo" bindtap="chooseFromAlbum">
          <view class="upload-icon"><icon name="image" size="64" color="#4f7fa6" /></view>
          <view class="upload-title">上传图片</view>
          <view class="upload-sub">选择照片后开始裁剪</view>
        </button>
      </view>
    </view>
  </scroll-view>

  <view class="bottom-action-bar">
    <button wx:if="{{imagePath}}" class="secondary-action" bindtap="replaceImage">
      <icon name="swap" size="28" />
      <text>换图</text>
    </button>
    <button wx:else class="secondary-action" bindtap="chooseFromAlbum">
      <icon name="image" size="28" />
      <text>上传</text>
    </button>
    <button class="primary-action {{!imagePath ? 'disabled' : ''}}" disabled="{{!imagePath}}" bindtap="goSize">
      <icon name="check" size="28" color="#fffaf0" />
      <text>确认裁剪</text>
    </button>
  </view>
</view>
