.upload-body {
  padding-top: 8rpx;
}

.crop-shell {
  position: relative;
  width: 100%;
  max-width: 100%;
  margin: 0 auto;
  overflow: hidden;
  border: 2rpx solid rgba(42, 31, 23, 0.07);
  border-radius: 40rpx;
  background:
    linear-gradient(to right, rgba(217, 205, 179, 0.42) 1rpx, transparent 1rpx),
    linear-gradient(to bottom, rgba(217, 205, 179, 0.42) 1rpx, transparent 1rpx),
    #fbf6ec;
  background-size: 42rpx 42rpx;
  box-shadow:
    0 2rpx 4rpx rgba(42, 31, 23, 0.03),
    0 24rpx 54rpx -30rpx rgba(42, 31, 23, 0.14);
}

.crop-photo {
  position: absolute;
  display: block;
}

.mock-photo {
  position: relative;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: var(--foreground);
}

.upload-icon {
  width: 112rpx;
  height: 112rpx;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(197, 106, 76, 0.1);
  color: var(--primary);
}

.upload-title {
  margin-top: 12rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.upload-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--muted-foreground);
}

.crop-frame {
  position: absolute;
  inset: 0;
  border: 4rpx solid rgba(255, 255, 255, 0.92);
  box-shadow:
    inset 0 0 0 2rpx rgba(0, 0, 0, 0.22),
    0 0 0 999px rgba(42, 31, 23, 0.08);
  pointer-events: none;
}

.third {
  position: absolute;
  background: rgba(255, 255, 255, 0.46);
}

.third-v {
  top: 0;
  bottom: 0;
  width: 1px;
}

.third-h {
  left: 0;
  right: 0;
  height: 1px;
}

.third-v.one {
  left: 33.333%;
}

.third-v.two {
  left: 66.666%;
}

.third-h.one {
  top: 33.333%;
}

.third-h.two {
  top: 66.666%;
}

.crop-size-pill {
  position: absolute;
  left: 50%;
  top: 18rpx;
  transform: translateX(-50%);
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.58);
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 700;
  padding: 6rpx 16rpx;
  white-space: nowrap;
}

.photo-chip {
  position: absolute;
  right: 24rpx;
  top: 24rpx;
  height: 52rpx;
  padding: 0 20rpx;
  display: flex;
  align-items: center;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.55);
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 600;
}

.crop-hint-card {
  margin-top: 22rpx;
  padding: 20rpx 22rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  border: 2rpx solid rgba(42, 31, 23, 0.07);
  border-radius: 30rpx;
  background: linear-gradient(180deg, #fffdfa 0%, #fff8ee 100%);
}

.hint-main {
  min-width: 0;
  flex: 1;
}

.hint-title {
  color: var(--foreground);
  font-size: 25rpx;
  font-weight: 700;
}

.hint-text {
  margin-top: 6rpx;
  color: var(--muted-foreground);
  font-size: 21rpx;
  line-height: 1.45;
}

/* v0 upload sync */
.upload-body {
  padding-top: 18rpx;
}

.crop-shell {
  border-radius: 52rpx;
  border-color: rgba(42, 31, 23, 0.07);
  background:
    radial-gradient(circle at 18% 20%, rgba(143, 182, 217, 0.26), transparent 26%),
    radial-gradient(circle at 82% 74%, rgba(197, 106, 76, 0.16), transparent 30%),
    linear-gradient(to right, rgba(217, 205, 179, 0.48) 1rpx, transparent 1rpx),
    linear-gradient(to bottom, rgba(217, 205, 179, 0.48) 1rpx, transparent 1rpx),
    #fbf6ec;
  background-size: auto, auto, 36rpx 36rpx, 36rpx 36rpx, auto;
  box-shadow:
    0 4rpx 8rpx rgba(42, 31, 23, 0.03),
    0 42rpx 88rpx -54rpx rgba(42, 31, 23, 0.25);
}

.crop-frame {
  border-width: 6rpx;
  border-radius: 42rpx;
  box-shadow:
    inset 0 0 0 2rpx rgba(0, 0, 0, 0.16),
    0 0 0 999px rgba(42, 31, 23, 0.06);
}

.crop-size-pill,
.photo-chip {
  background: rgba(42, 31, 23, 0.68);
  box-shadow: 0 14rpx 30rpx -22rpx rgba(42, 31, 23, 0.4);
}

.mock-photo {
  background:
    radial-gradient(circle at 50% 35%, rgba(255, 255, 255, 0.66), transparent 30%);
}

.upload-icon {
  border-radius: 28rpx;
  background: rgba(143, 182, 217, 0.18);
  color: #4f7fa6;
}

.crop-hint-card {
  border-radius: 34rpx;
  border-color: rgba(42, 31, 23, 0.07);
  background: linear-gradient(180deg, rgba(255, 253, 248, 0.98), rgba(255, 250, 242, 0.98));
  box-shadow: 0 30rpx 66rpx -46rpx rgba(42, 31, 23, 0.22);
}
