<view class="screen tone-mint">
  <view class="app-header" style="{{navStyle}}">
    <view class="header-side">
      <button class="back-btn" bindtap="goBack"><icon name="back" size="32" /></button>
    </view>
    <view class="header-center">
      <view class="header-title">色号识别</view>
      <view class="header-subtitle">点击图片取色</view>
    </view>
    <view class="header-side right">
      <button class="icon-btn" open-type="share" aria-label="share"><icon name="share" size="30" /></button>
      <button class="icon-btn" bindtap="goHome"><icon name="home" size="30" /></button>
    </view>
  </view>

  <scroll-view scroll-y enhanced="{{true}}" bounces="{{false}}" show-scrollbar="{{false}}" class="scroll-body flow-body pick-body">
    <view class="card-feature pick-stage">
      <view class="sample-image picker-shell picker-canvas-shell">
        <canvas
          canvas-id="pickerCanvas"
          class="picker-canvas"
          width="{{canvasWidth}}"
          height="{{canvasHeight}}"
          style="width: {{canvasWidth}}px; height: {{canvasHeight}}px;"
          bindtap="onCanvasTap"
          bindtouchstart="onCanvasTouchStart"
          catchtouchmove="onCanvasTouchMove"
          bindtouchend="onCanvasTouchEnd"
          bindtouchcancel="onCanvasTouchEnd"
        ></canvas>
        <view wx:if="{{!imagePath}}" class="picker-gradient" bindtap="chooseImage">
          <view class="picker-upload"><icon name="image" size="28" color="#fff" /> 上传图片</view>
          <view class="picker-hint">点击后在图片上取样</view>
        </view>
        <view wx:if="{{showLoupe && imagePath}}" class="loupe" style="left: {{markerLeft}}px; top: {{markerTop}}px;">
          <view class="loupe-preview">
            <image class="loupe-image" src="{{imagePath}}" mode="scaleToFill" style="{{loupeImageStyle}}"></image>
            <view class="loupe-crosshair"></view>
          </view>
          <view class="loupe-stem"></view>
          <view class="loupe-label">{{picked ? picked.hex : '取样中'}}</view>
        </view>
      </view>

      <view class="pick-current">
        <view class="pick-swatch" style="background: {{picked ? picked.hex : '#8FC8E8'}};"></view>
        <view>
          <text>当前取样</text>
          <text class="pick-hex">{{picked ? picked.hex : '#8FC8E8'}}</text>
        </view>
        <text class="tag">{{picked ? '已锁定' : '待取色'}}</text>
      </view>
    </view>

    <view class="v0-section-title">
      <text class="section-label">匹配色号</text>
      <text class="section-action">{{matches.length ? matches.length + ' 项' : '待取样'}}</text>
    </view>

    <view class="match-list">
      <view wx:for="{{matches}}" wx:key="paletteId" class="match-row">
        <image class="palette-logo" src="{{item.icon}}" mode="aspectFit"></image>
        <view class="match-swatch" style="background: {{item.hex}};"></view>
        <view class="match-main">
          <view class="match-title">{{item.code}}</view>
          <view class="match-name">{{item.paletteName}} · {{item.name}}</view>
        </view>
        <view class="match-score">
          <text>{{item.distance}}</text>
          <text>ΔE</text>
        </view>
      </view>
      <view wx:if="{{!matches.length}}" class="empty-row">上传图片后点击颜色，即可匹配各品牌色号。</view>
    </view>
  </scroll-view>
</view>
