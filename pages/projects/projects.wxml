<view class="screen tone-mint">
  <view class="app-header" style="{{navStyle}}">
    <view class="header-side">
      <button class="back-btn" bindtap="goBack"><icon name="back" size="32" /></button>
    </view>
    <view class="header-center">
      <view class="header-title">我的作品</view>
      <view class="header-subtitle">已保存 {{projectCount}} 个图纸</view>
    </view>
    <view class="header-side right">
      <button class="icon-btn" open-type="share" aria-label="share"><icon name="share" size="30" /></button>
      <button class="icon-btn" bindtap="goHome"><icon name="home" size="30" /></button>
    </view>
  </view>

  <scroll-view scroll-y enhanced="{{true}}" bounces="{{false}}" show-scrollbar="{{false}}" class="scroll-body flow-body projects-body">
    <view class="v0-section-title">
      <text class="section-label">我的作品</text>
      <text class="section-action">{{projects.length ? projects.length + ' 个' : '空'}}</text>
    </view>

    <view wx:if="{{projects.length === 0}}" class="empty-card">
      <view class="empty-art">
        <view class="empty-dot dot-a"></view>
        <view class="empty-dot dot-b"></view>
        <view class="empty-dot dot-c"></view>
      </view>
      <view class="empty-title">作品空空的</view>
      <view class="empty-sub">开始一次创作，作品会自动保存在这里。</view>
      <button class="empty-btn" bindtap="goDraw">开始创作</button>
    </view>

    <view wx:else class="project-list">
      <button wx:for="{{projects}}" wx:key="id" class="project-row" data-id="{{item.id}}" bindtap="openProject">
        <view class="thumb-shell">
          <view
            class="thumb-grid"
            style="width: {{item.thumbWidthPercent}}%; height: {{item.thumbHeightPercent}}%; grid-template-columns: repeat({{item.previewWidth}}, 1fr); grid-template-rows: repeat({{item.previewHeight}}, 1fr);"
          >
            <view
              wx:for="{{item.previewCells}}"
              wx:key="index"
              class="thumb-cell {{item.empty ? 'empty' : ''}}"
              style="background: {{item.hex}};"
            ></view>
          </view>
        </view>
        <view class="project-main">
          <view class="project-title">{{item.name}}</view>
          <view class="project-meta">
            <text>{{item.typeLabel}}</text>
            <text>{{item.width}} x {{item.height}}</text>
            <text>{{item.colorCount}} 色</text>
          </view>
          <view class="progress-track"><view style="width: 100%;"></view></view>
        </view>
        <icon name="forward" size="28" />
      </button>
    </view>
  </scroll-view>
</view>
